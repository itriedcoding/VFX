	{ key = "width0", label = "Width start", type = "number", min = 0, max = 20, step = 0.05 },
	{ key = "width1", label = "Width end", type = "number", min = 0, max = 20, step = 0.05 },
	{ key = "curveSize0", label = "Curve start", type = "number", min = -5, max = 5, step = 0.1 },
	{ key = "curveSize1", label = "Curve end", type = "number", min = -5, max = 5, step = 0.1 },
	{ key = "segments", label = "Segments", type = "number", min = 1, max = 100, step = 1 },
	{ key = "brightness", label = "Brightness", type = "number", min = 0, max = 10, step = 0.1 },
	{ key = "lightEmission", label = "Light emission", type = "number", min = 0, max = 1, step = 0.01 },
	{ key = "lightInfluence", label = "Light influence", type = "number", min = 0, max = 1, step = 0.01 },
	{ key = "textureLength", label = "Texture length", type = "number", min = 0.01, max = 20, step = 0.05 },
	{ key = "textureSpeed", label = "Texture speed", type = "number", min = -10, max = 10, step = 0.1 },
	{ key = "textureMode", label = "Texture mode", type = "enum", enum = "TextureMode" },
	{ key = "faceCamera", label = "Face camera", type = "boolean" },
	{ key = "zOffset", label = "Z offset", type = "number", min = -20, max = 20, step = 0.1 },
	{ key = "color", label = "Colour", type = "color" },
	{ key = "transparency", label = "Opacity", type = "curve01" },
	{ key = "offset1", label = "End offset", type = "vector3", min = -40, max = 40 },
}

local TRAIL_FIELDS = {
	{ key = "texture", label = "Texture", type = "texture" },
	{ key = "lifetime", label = "Lifetime", type = "number", min = 0.05, max = 10, step = 0.05, unit = "s" },
	{ key = "minLength", label = "Min length", type = "number", min = 0, max = 10, step = 0.05 },
	{ key = "widthScale", label = "Width scale", type = "number", min = 0, max = 8, step = 0.05 },
	{ key = "lightEmission", label = "Light emission", type = "number", min = 0, max = 1, step = 0.01 },
	{ key = "faceCamera", label = "Face camera", type = "boolean" },
	{ key = "color", label = "Colour", type = "color" },
	{ key = "transparency", label = "Opacity", type = "curve01" },
	{ key = "offset0", label = "Start offset", type = "vector3", min = -20, max = 20 },
	{ key = "offset1", label = "End offset", type = "vector3", min = -20, max = 20 },
}

local LIGHT_FIELDS = {
	{ key = "color", label = "Colour", type = "swatch" },
	{ key = "brightness", label = "Brightness", type = "number", min = 0, max = 20, step = 0.1 },
	{ key = "range", label = "Range", type = "number", min = 0, max = 80, step = 0.5 },
	{ key = "shadows", label = "Shadows", type = "boolean" },
	{ key = "offset", label = "Offset", type = "vector3", min = -40, max = 40 },
}

local PART_FIELDS = {
	{ key = "color", label = "Colour", type = "swatch" },
	{ key = "size", label = "Size", type = "vector3", min = 0.1, max = 40 },
	{ key = "transparency", label = "Transparency", type = "number", min = 0, max = 1, step = 0.01 },
	{ key = "material", label = "Material", type = "enum", enum = "Material" },
	{ key = "shape", label = "Shape", type = "options", options = { "Block", "Ball", "Cylinder", "Wedge" } },
	{ key = "rotation", label = "Rotation", type = "vector3", min = -360, max = 360 },
	{ key = "spin", label = "Spin", type = "vector3", min = -360, max = 360 },
	{ key = "float", label = "Float", type = "number", min = -20, max = 20, step = 0.1 },
	{ key = "offset", label = "Offset", type = "vector3", min = -40, max = 40 },
}

local TWEEN_FIELDS = {
	{ key = "property", label = "Property", type = "options", options = { "spin", "float", "brightness", "transparency", "scale" } },
	{ key = "target", label = "Target", type = "target" },
	{ key = "from", label = "From", type = "number", min = -720, max = 720, step = 1 },
	{ key = "to", label = "To", type = "number", min = -720, max = 720, step = 1 },
	{ key = "easing", label = "Easing", type = "enum", enum = "EasingStyle" },
	{ key = "direction", label = "Direction", type = "enum", enum = "EasingDirection" },
	{ key = "repeatCount", label = "Repeat count", type = "number", min = 0, max = 100, step = 1 },
	{ key = "reverse", label = "Reverse", type = "boolean" },
}

local SCHEMA = {
	particle = PARTICLE_FIELDS,
	beam = BEAM_FIELDS,
	trail = TRAIL_FIELDS,
	light = LIGHT_FIELDS,
	part = PART_FIELDS,
	tween = TWEEN_FIELDS,
}

local COLOR_PRESETS = {
	{ name = "Inferno", colors = { "#fff3b0", "#ff9a1f", "#e02c00" } },
	{ name = "Ice", colors = { "#ffffff", "#9fe4ff", "#2a6fff" } },
	{ name = "Toxic", colors = { "#eaffb0", "#8dff3d", "#1fa34a" } },
	{ name = "Gold", colors = { "#fffbe0", "#ffd75e", "#c98a00" } },
	{ name = "Void", colors = { "#e3c6ff", "#8a4bff", "#2c0f52" } },
	{ name = "Arcane", colors = { "#d9fbff", "#46e0ff", "#5f3bff" } },
	{ name = "Blood", colors = { "#ffb0b0", "#e02020", "#5d0000" } },
	{ name = "Plasma", colors = { "#fdffe0", "#5cffb0", "#0f7bff" } },
}

--------------------------------------------------------------------------------
-- colour helpers
--------------------------------------------------------------------------------

local function sampleColor(points: { any }, alpha: number): Color3
	if not points or #points == 0 then
		return Theme.color.white
	end
	if #points == 1 then
		return Util.hex(points[1][2])
	end
	local low = points[1]
	local high = points[#points]
	for index = 1, #points - 1 do
		if alpha >= (points[index][1] or 0) and alpha <= (points[index + 1][1] or 0) then
			low = points[index]
			high = points[index + 1]
			break
		end
	end
	local timeLow = tonumber(low[1]) or 0
	local timeHigh = tonumber(high[1]) or 1
	local span = timeHigh - timeLow
	local fraction = if span <= 0 then 0 else (alpha - timeLow) / span
	return Util.hex(low[2]):Lerp(Util.hex(high[2]), math.clamp(fraction, 0, 1))
end

local function sampleNumber(points: { any }, alpha: number): number
	if not points or #points == 0 then
		return 0
	end
	if #points == 1 then
		return tonumber(points[1][2]) or 0
	end
	local low = points[1]
	local high = points[#points]
	for index = 1, #points - 1 do
		if alpha >= (points[index][1] or 0) and alpha <= (points[index + 1][1] or 0) then
			low = points[index]
			high = points[index + 1]
			break
		end
	end
	local timeLow = tonumber(low[1]) or 0
	local timeHigh = tonumber(high[1]) or 1
	local span = timeHigh - timeLow
	local fraction = if span <= 0 then 0 else (alpha - timeLow) / span
	return Util.lerp(tonumber(low[2]) or 0, tonumber(high[2]) or 0, math.clamp(fraction, 0, 1))
end

local function sorted(points: { any }): { any }
	local copy = {}
	for _, point in ipairs(points) do
		table.insert(copy, { tonumber(point[1]) or 0, point[2] })
	end
	table.sort(copy, function(a, b)
		return a[1] < b[1]
	end)
	return copy
end

--------------------------------------------------------------------------------
-- construction
--------------------------------------------------------------------------------

function Inspector.new(parent: Instance, ctx: any)
	local self = setmetatable({}, Inspector)
	self.ctx = ctx
	self.store = ctx.store
	self.tab = "Properties"		self.curveMode = "color"
		self.activeStop = 1
		self.interacting = false
		self.connections = {}
		self.leftWidth = 286

	local root = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.color.bg1,
	})
	self.root = root

	local header = Kit.frame(root, {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	Kit.label(header, "Inspector", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 16),
		Font = Theme.font.bold,
		TextSize = Theme.text.title,
	})

	self.tabBar = Kit.hlist(root, 4, {
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.fromOffset(10, 34),
	})
	self.tabBar.AutomaticSize = Enum.AutomaticSize.None
	self.tabBar.Size = UDim2.new(1, -20, 0, 26)

	self.tabButtons = {}
	local tabNames = {
		{ name = "Properties", label = "Properties" },
		{ name = "Curves", label = "Curves" },
		{ name = "Cost", label = "Cost" },
	}
	for _, entry in ipairs(tabNames) do
		local button = Kit.button(self.tabBar, entry.label, {
			variant = "ghost",
			height = 24,
			size = UDim2.fromOffset(entry.name == "Properties" and 82 or 62, 24),
			textSize = Theme.text.small,
			onClick = function()
				self:showTab(entry.name)
			end,
		})
		button.TextColor3 = if entry.name == self.tab then Theme.color.text else Theme.color.textMuted
		self.tabButtons[entry.name] = button
	end

	local content = Kit.frame(root, {
		Size = UDim2.new(1, 0, 1, -68),
		Position = UDim2.fromOffset(0, 66),
		BackgroundTransparency = 1,
	})
	self.content = content

	local properties = Kit.scroll(content, {
		Size = UDim2.new(1, 0, 1, 0),
	}, 9)
	self.properties = properties

	local curves = Kit.scroll(content, {
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
	}, 9)
	self.curves = curves

	local cost = Kit.scroll(content, {
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
	}, 9)
	self.cost = cost

	self:bind()
	self:rebuild()
	return self
end

function Inspector:bind()
	table.insert(self.connections, self.store.signals:on("spec", function()
		self:rebuild()
	end))
	table.insert(self.connections, self.store.signals:on("selection", function()
		self:rebuild()
	end))
	table.insert(self.connections, self.store.signals:on("field", function(payload)
		if self.tab == "Cost" then
			self:renderCost()
		end
		if payload and payload.key == "color" and self.tab == "Curves" and not self.interacting then
			self:renderCurves()
		end
	end))
end

function Inspector:showTab(name: string)
	self.tab = name
	for tabName, button in pairs(self.tabButtons) do
		button.TextColor3 = if tabName == name then Theme.color.text else Theme.color.textMuted
	end
	self.properties.Visible = name == "Properties"
	self.curves.Visible = name == "Curves"
	self.cost.Visible = name == "Cost"
	if name == "Curves" then
		self:renderCurves()
	elseif name == "Cost" then
		self:renderCost()
	else
		self:rebuild()
	end
end

function Inspector:rebuild()
	Kit.clear(self.properties)
	self:renderMeta()
	self:renderComponentStack()
	self:renderFields()
	if self.tab == "Curves" then
		self:renderCurves()
	elseif self.tab == "Cost" then
		self:renderCost()
	end
end

--------------------------------------------------------------------------------
-- effect metadata
--------------------------------------------------------------------------------

function Inspector:renderMeta()
	local spec = self.store:working()
	local section = Kit.sectionTitle(self.properties, "Effect")
	section.LayoutOrder = 1

	local nameBox = Kit.textBox(self.properties, tostring(spec.name or ""), {
		placeholder = "Effect name",
		size = UDim2.new(1, 0, 0, 26),
		onSubmit = function(text)
			local trimmed = Util.trim(text)
			if trimmed ~= "" and trimmed ~= spec.name then
				self.store:pushHistory("Rename effect")
				spec.name = trimmed
				self.store.signals:fire("spec")
			end
		end,
	})
	nameBox.LayoutOrder = 2

	local info = Kit.caption(self.properties, string.format(
		"%s  \u{00b7}  %d components  \u{00b7}  %s",
		tostring(spec.category or "Custom"),
		#spec.components,
		Util.formatDuration(spec.duration or 1)
	), {
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 3,
	})
	info.TextWrapped = false

	if spec.description then
		local description = Kit.caption(self.properties, spec.description, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		description.LayoutOrder = 4
	end

	local actions = Kit.hlist(self.properties, 6)
	actions.LayoutOrder = 5
	actions.Size = UDim2.new(1, 0, 0, 26)
	Kit.button(actions, "Save as preset", {
		variant = "secondary",
		height = 26,
		size = UDim2.new(0, 108, 0, 26),
		textSize = Theme.text.small,
		onClick = function()
			self.ctx.promptSavePreset()
		end,
	})
	Kit.button(actions, "Import", {
		variant = "ghost",
		height = 26,
		size = UDim2.new(0, 62, 0, 26),
		textSize = Theme.text.small,
		tooltip = "Import the selected instance as an editable effect",
		onClick = function()
			self.ctx.importSelection()
		end,
	})
	Kit.button(actions, "Reset", {
		variant = "ghost",
		height = 26,
		size = UDim2.new(0, 56, 0, 26),
		textSize = Theme.text.small,
		onClick = function()
			self.ctx.reloadPreset()
		end,
	})

	local divider = Kit.divider(self.properties)
	divider.LayoutOrder = 6
end

--------------------------------------------------------------------------------
-- component stack
--------------------------------------------------------------------------------

function Inspector:renderComponentStack()
	local spec = self.store:working()
	local header = Kit.hlist(self.properties, 8)
	header.LayoutOrder = 7
	header.Size = UDim2.new(1, 0, 0, 20)
	Kit.label(header, string.upper("Components"), {
		Size = UDim2.new(0, 90, 1, 0),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
		Font = Theme.font.bold,
	})

	local addHolder = Kit.frame(header, {
		Size = UDim2.new(0, 104, 0, 20),
		BackgroundTransparency = 1,
	})
	local addDropdown = Kit.dropdown(addHolder, {
		options = ADD_OPTIONS,
		placeholder = "+ Add",
		value = nil,
		height = 20,
		maxHeight = 150,
		onChange = function(value)
			self.store:addComponent(tostring(value))
		end,
	})
	addDropdown.Set(nil)
	local addLabel = Kit.label(addHolder, "+ Add component", {
		Size = UDim2.new(1, 0, 1, 0),
		TextColor3 = Theme.color.accentBright,
		TextSize = Theme.text.tiny,
		Font = Theme.font.bold,
	})

	local stack = Kit.frame(self.properties, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	stack.LayoutOrder = 8
	local stackLayout = Instance.new("UIListLayout")
	stackLayout.Padding = UDim.new(0, 2)
	stackLayout.SortOrder = Enum.SortOrder.LayoutOrder
	stackLayout.Parent = stack
	self.stack = stack

	if #spec.components == 0 then
		Kit.caption(stack, "No components yet - add one above.", {
			Size = UDim2.new(1, 0, 0, 20),
		})
	end

	local rows = {}
	for index, comp in ipairs(spec.components) do
		local active = index == self.store.selection
		local row = Kit.frame(stack, {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundColor3 = if active then Theme.color.accentSoft else Theme.color.bg2,
			BackgroundTransparency = if active then 0 else 0.25,
		})
		row.LayoutOrder = index
		Theme.corner(row, Theme.radius.xs)

		local handle = Kit.label(row, "\u{2261}", {
			Size = UDim2.fromOffset(16, 26),
			Position = UDim2.fromOffset(4, 0),
			TextColor3 = Theme.color.textFaint,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		handle.ZIndex = 4

		Kit.label(row, string.format("%s  %s", KIND_GLYPHS[comp.kind] or "\u{25c6}", tostring(comp.name)), {
			Size = UDim2.new(1, -92, 1, 0),
			Position = UDim2.fromOffset(22, 0),
			TextColor3 = if active then Theme.color.text else Theme.color.textDim,
			TextSize = Theme.text.small,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})

		local duplicate = Kit.iconButton(row, "\u{29c9}", {
			size = UDim2.fromOffset(20, 20),
			tooltip = "Duplicate component",
			onClick = function()
				self.store:duplicateComponent(index)
			end,
		})
		duplicate.Position = UDim2.new(1, -46, 0, 3)
		duplicate.ZIndex = 4

		local remove = Kit.iconButton(row, "\u{00d7}", {
			size = UDim2.fromOffset(20, 20),
			tooltip = "Delete component",
			onClick = function()
				self.store:removeComponent(index)
			end,
		})
		remove.Position = UDim2.new(1, -24, 0, 3)
		remove.ZIndex = 4
		remove.TextColor3 = Theme.color.bad

		local click = Instance.new("TextButton")
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.new(1, -50, 1, 0)
		click.Position = UDim2.fromOffset(20, 0)
		click.ZIndex = 2
		click.Parent = row
		click.Activated:Connect(function()
			self.store:select(index)
		end)

		Kit.drag(handle, {
			begin = function()
				self.store:select(index)
				self.dragRow = index
			end,
			move = function(_, y)
				if not self.dragRow then
					return
				end
				local target = math.clamp(math.floor((y - stack.AbsolutePosition.Y) / 28) + 1, 1, #spec.components)
				if target ~= self.dragRow then
					self.store:moveComponent(self.dragRow, target)
					self.dragRow = target
				end
			end,
			finish = function()
				self.dragRow = nil
			end,
		})

		rows[index] = row
	end

	local divider = Kit.divider(self.properties)
	divider.LayoutOrder = 9
end

--------------------------------------------------------------------------------
-- field rendering
--------------------------------------------------------------------------------

function Inspector:renderFields()
	local spec = self.store:working()
	local comp = spec.components[self.store.selection]
	local header = Kit.sectionTitle(self.properties, if comp then "Properties - " .. tostring(comp.name) else "Properties")
	header.LayoutOrder = 10

	if not comp then
		Kit.caption(self.properties, "Select a component to edit it.", { LayoutOrder = 11 })
		return
	end

	local schema = SCHEMA[comp.kind] or {}
	local order = 10

	-- Component name + timing are shared by every kind.
	order += 1
	local nameRow, nameHolder = Kit.row(self.properties, "Name")
	nameRow.LayoutOrder = order
	local nameBox = Kit.textBox(nameHolder, tostring(comp.name), {
		size = UDim2.new(1, 0, 0, 24),
		onSubmit = function(text)
			self.store:renameComponent(self.store.selection, text)
		end,
	})
	nameBox.Size = UDim2.new(1, 0, 0, 24)

	order += 1
	local startRow, startHolder = Kit.row(self.properties, "Start time", "When this component begins emitting, in seconds.")
	startRow.LayoutOrder = order
	local startBox = Kit.numberBox(startHolder, tonumber(comp.startTime) or 0, {
		min = 0,
		max = 30,
		size = UDim2.new(1, 0, 0, 24),
		onChange = function(value)
			self.store:setField(self.store.selection, "startTime", value, true)
		end,
	})
	startBox.Parent = startHolder

	order += 1
	local durationRow, durationHolder = Kit.row(self.properties, "Duration", "How long the component stays active. 0 means a single burst.")
	durationRow.LayoutOrder = order
	local compDuration = Kit.numberBox(durationHolder, tonumber(comp.duration) or 0, {
		min = 0,
		max = 30,
		size = UDim2.new(1, 0, 0, 24),
		onChange = function(value)
			self.store:setField(self.store.selection, "duration", value, true)
		end,
	})
	compDuration.Parent = durationHolder

	if comp.kind == "particle" then
		order += 1
		local burstRow, burstHolder = Kit.row(self.properties, "Burst count", "Particles emitted at once when the component starts.")
		burstRow.LayoutOrder = order
		local burstBox = Kit.numberBox(burstHolder, tonumber(comp.burst) or 0, {
			min = 0,
			max = 2000,
			size = UDim2.new(1, 0, 0, 24),
			onChange = function(value)
				self.store:setField(self.store.selection, "burst", value, true)
			end,
		})
		burstBox.Parent = burstHolder

		order += 1
		local repeatsRow, repeatsHolder = Kit.row(self.properties, "Burst repeats", "How many bursts play across the duration.")
		repeatsRow.LayoutOrder = order
		local repeatsBox = Kit.numberBox(repeatsHolder, tonumber(comp.repeats) or 1, {
			min = 1,
			max = 50,
			size = UDim2.new(1, 0, 0, 24),
			onChange = function(value)
				self.store:setField(self.store.selection, "repeats", math.max(1, math.floor(value)), true)
			end,
		})
		repeatsBox.Parent = repeatsHolder
	end

	if comp.kind == "tween" then
		order += 1
		local reverseRow, reverseHolder = Kit.row(self.properties, "Reverse")
		reverseRow.LayoutOrder = order
		local reverseToggle = Kit.toggle(reverseHolder, comp.reverse == true, function(value)
			self.store:setField(self.store.selection, "reverse", value, true)
		end)
		reverseToggle.Parent = reverseHolder
	end

	for _, field in ipairs(schema) do
		order += 1
		local ok, err = pcall(function()
			self:renderField(field, comp, order)
		end)
		if not ok then
			warn("[VFX Studio] field '" .. tostring(field.key) .. "' failed: " .. tostring(err))
		end
	end
end

function Inspector:renderField(field: any, comp: any, order: number)
	local key = field.key
	local label = field.label
	local value = comp[key]

	if field.type == "number" then
		local row, holder = Kit.row(self.properties, label, field.hint)
		row.LayoutOrder = order
		local box = Kit.numberBox(holder, tonumber(value) or 0, {
			min = field.min,
			max = field.max,
			size = UDim2.new(1, 0, 0, 24),
			onChange = function(newValue)
				self.store:setField(self.store.selection, key, newValue)
			end,
		})
		box.Parent = holder
		return
	elseif field.type == "boolean" then
		local row, holder = Kit.row(self.properties, label, field.hint)
		row.LayoutOrder = order
		local toggle = Kit.toggle(holder, value == true, function(newValue)
			self.store:setField(self.store.selection, key, newValue, true)
		end)
		toggle.Parent = holder
		return
	elseif field.type == "range" then
		local row = Kit.vlist(self.properties, 3)
		row.LayoutOrder = order
		row.Size = UDim2.new(1, 0, 0, 0)
		local head = Kit.hlist(row, 6)
		head.Size = UDim2.new(1, 0, 0, 14)
		Kit.caption(head, label, { Size = UDim2.new(1, -60, 1, 0) })
		local minValue = tonumber((value or {})[1]) or 0
		local maxValue = tonumber((value or {})[2]) or minValue
		Kit.label(head, string.format("%s - %s", Util.pretty(minValue), Util.pretty(maxValue)), {
			Size = UDim2.fromOffset(60, 14),
			TextColor3 = Theme.color.textMuted,
			Font = Theme.font.mono,
			TextSize = Theme.text.tiny,
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		local controls = Kit.hlist(row, 4)
		controls.Size = UDim2.new(1, 0, 0, 24)
		local minBox = Kit.numberBox(controls, minValue, {
			min = field.min,
			max = field.max,
			size = UDim2.new(0.5, -2, 0, 24),
			onChange = function(newMin)
				local current = comp[key] or { 0, 0 }
				local upper = tonumber(current[2]) or newMin
				self.store:setField(self.store.selection, key, { newMin, math.max(newMin, upper) })
			end,
		})
		minBox.Parent = controls
		local maxBox = Kit.numberBox(controls, maxValue, {
			min = field.min,
			max = field.max,
			size = UDim2.new(0.5, -2, 0, 24),
			onChange = function(newMax)
				local current = comp[key] or { 0, 0 }
				local lower = tonumber(current[1]) or 0
				self.store:setField(self.store.selection, key, { math.min(lower, newMax), newMax })
			end,
		})
		maxBox.Parent = controls
		return
	elseif field.type == "vector2" or field.type == "vector3" then
		local row = Kit.vlist(self.properties, 3)
		row.LayoutOrder = order
		row.Size = UDim2.new(1, 0, 0, 0)
		Kit.caption(row, label, { Size = UDim2.new(1, 0, 0, 14) })
		local controls = Kit.hlist(row, 4)
		controls.Size = UDim2.new(1, 0, 0, 24)
		local count = if field.type == "vector2" then 2 else 3
		local axes = { "X", "Y", "Z" }
		local boxes = {}
		for index = 1, count do
			local holder = Kit.frame(controls, {
				Size = UDim2.new(1 / count, -3, 0, 24),
				BackgroundColor3 = Theme.color.bg1,
			})
			Theme.corner(holder, Theme.radius.xs)
			local box = Kit.numberBox(holder, tonumber((value or {})[index]) or 0, {
				min = field.min,
				max = field.max,
				size = UDim2.new(1, 0, 0, 24),
				onChange = function(newValue)
					local current = {}
					for i = 1, count do
						current[i] = tonumber((comp[key] or {})[i]) or 0
					end
					current[index] = newValue
					self.store:setField(self.store.selection, key, current)
				end,
			})
			box.Parent = holder
			table.insert(boxes, box)
		end
		return
	elseif field.type == "enum" then
		local row, holder = Kit.row(self.properties, label)
		row.LayoutOrder = order
		local enumType = (Enum :: any)[field.enum]
		local options = {}
		if enumType then
			for _, item in ipairs(enumType:GetEnumItems()) do
				table.insert(options, { value = item.Name, label = item.Name })
			end
		end
		local dropdown = Kit.dropdown(holder, {
			options = options,
			value = tostring(value or ""),
			height = 24,
			maxHeight = 150,
			onChange = function(newValue)
				self.store:setField(self.store.selection, key, tostring(newValue), true)
			end,
		})
		dropdown.Parent = holder
		return
	elseif field.type == "options" then
		local row, holder = Kit.row(self.properties, label)
		row.LayoutOrder = order
		local options = {}
		for _, option in ipairs(field.options) do
			table.insert(options, { value = option, label = option })
		end
		local dropdown = Kit.dropdown(holder, {
			options = options,
			value = tostring(value or field.options[1]),
			height = 24,
			maxHeight = 150,
			onChange = function(newValue)
				self.store:setField(self.store.selection, key, tostring(newValue), true)
			end,
		})
		dropdown.Parent = holder
		return
	elseif field.type == "target" then
		local row, holder = Kit.row(self.properties, label, "Which component this motion track drives.")
		row.LayoutOrder = order
		local options = { { value = "rig", label = "Whole effect" } }
		for _, other in ipairs(self.store:working().components) do
			if other.kind ~= "tween" then
				table.insert(options, { value = other.name, label = other.name })
			end
		end
		local dropdown = Kit.dropdown(holder, {
			options = options,
			value = tostring(value or "rig"),
			height = 24,
			maxHeight = 150,
			onChange = function(newValue)
				self.store:setField(self.store.selection, key, tostring(newValue), true)
			end,
		})
		dropdown.Parent = holder
		return
	elseif field.type == "texture" then
		self:renderTextureField(field, comp, order)
		return
	elseif field.type == "color" or field.type == "curve01" or field.type == "curve" then
		self:renderCurveField(field, comp, order)
		return
	elseif field.type == "swatch" then
		local block = Kit.vlist(self.properties, 4)
		block.LayoutOrder = order
		block.Size = UDim2.new(1, 0, 0, 0)

		local head = Kit.hlist(block, 6)
		head.Size = UDim2.new(1, 0, 0, 24)

		local swatch = Kit.colorSwatch(head, Util.hex(tostring(value or "#ffffff")), UDim2.fromOffset(24, 24))
		local hexBox = Kit.textBox(head, tostring(value or "#ffffff"), {
			size = UDim2.new(0, 84, 0, 24),
			font = Theme.font.mono,
			onSubmit = function(text)
				local trimmed = Util.trim(text)
				if string.match(trimmed, "^#?%x%x%x%x%x%x$") then
					local normalized = "#" .. string.gsub(trimmed, "#", "")
					self.store:setField(self.store.selection, key, normalized, true)
					swatch.BackgroundColor3 = Util.hex(normalized)
				else
					self.ctx.toast("Enter a hex colour like #ff8800", "warn")
				end
			end,
		})
		hexBox.Parent = head

		local palette = Kit.hlist(block, 4)
		palette.Size = UDim2.new(1, 0, 0, 18)
		for _, preset in ipairs(COLOR_PRESETS) do
			local dot = Kit.colorSwatch(palette, Util.hex(preset.colors[2]), UDim2.fromOffset(18, 18))
			local click = Instance.new("TextButton")
			click.BackgroundTransparency = 1
			click.Text = ""
			click.Size = UDim2.fromScale(1, 1)
			click.Parent = dot
			click.Activated:Connect(function()
				self.store:setField(self.store.selection, key, preset.colors[2], true)
				swatch.BackgroundColor3 = Util.hex(preset.colors[2])
				hexBox.Text = preset.colors[2]
			end)
			Kit.tooltip(click, preset.name)
		end
		return
	end
end

function Inspector:renderTextureField(field: any, comp: any, order: number)
	local container = Kit.frame(self.properties, {
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	container.LayoutOrder = order

	Kit.caption(container, field.label, {
		Size = UDim2.new(1, 0, 0, 14),
	})

	local preview = Kit.frame(container, {
		Size = UDim2.new(1, -74, 0, 38),
		Position = UDim2.fromOffset(0, 18),
		BackgroundColor3 = Theme.color.bg0,
	})
	Theme.corner(preview, Theme.radius.xs)

	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.new(1, -8, 1, -8)
	image.Position = UDim2.fromOffset(4, 4)
	image.Image = Assets.resolve(comp[field.key])
	image.ImageColor3 = Theme.color.white
	image.ScaleType = Enum.ScaleType.Fit
	image.Parent = preview

	Kit.label(preview, Assets.describe(Assets.resolve(comp[field.key])), {
		Size = UDim2.new(1, -12, 0, 12),
		Position = UDim2.new(0, 6, 1, -14),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local browse = Kit.button(container, "Change", {
		variant = "secondary",
		height = 38,
		size = UDim2.fromOffset(68, 38),
		textSize = Theme.text.small,
		onClick = function()
			self.ctx.openAssetPicker(function(uri: string)
				self.store:setField(self.store.selection, field.key, uri, true)
				image.Image = uri
			end)
		end,
	})
	browse.Position = UDim2.new(1, -68, 0, 18)
end

function Inspector:renderCurveField(field: any, comp: any, order: number)
	local container = Kit.frame(self.properties, {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	container.LayoutOrder = order

	Kit.caption(container, field.label, {
		Size = UDim2.new(1, -60, 0, 14),
	})

	local edit = Kit.button(container, "Edit", {
		variant = "ghost",
		height = 16,
		size = UDim2.fromOffset(44, 16),
		textSize = Theme.text.tiny,
		onClick = function()
			self.curveMode = if field.type == "color" then "color" elseif field.key == "size" then "size" else "transparency"
			self.showTab("Curves")
			self:renderCurves()
		end,
	})
	edit.Position = UDim2.new(1, -44, 0, -1)

	local strip = Kit.frame(container, {
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 16),
		BackgroundColor3 = Theme.color.bg0,
	})
	Theme.corner(strip, Theme.radius.xs)

	if field.type == "color" then
		local keypoints = sorted(comp[field.key] or {})
		for index = 1, 32 do
			local alpha = (index - 1) / 31
			local sample = Kit.frame(strip, {
				Size = UDim2.new(1 / 32, 1, 1, 0),
				Position = UDim2.fromScale((index - 1) / 32, 0),
				BackgroundColor3 = sampleColor(keypoints, alpha),
			})
		end
	else
		local keypoints = comp[field.key] or {}
		local peak = 0.0001
		if field.key == "transparency" then
			peak = 1
		else
			for _, kp in ipairs(keypoints) do
				peak = math.max(peak, tonumber(kp[2]) or 0)
			end
		end
		for index = 1, 32 do
			local alpha = (index - 1) / 31
			local value = sampleNumber(keypoints, alpha)
			local height = math.clamp(if field.key == "transparency" then 1 - value else value / (peak * 1.15), 0, 1)
			local bar = Kit.frame(strip, {
				Size = UDim2.new(1 / 32, 1, height, 0),
				Position = UDim2.new((index - 1) / 32, 0, 1, 0),
				BackgroundColor3 = if field.key == "transparency" then Theme.color.accentBright else Theme.color.accent,
				AnchorPoint = Vector2.new(0, 1),
			})
			bar.BackgroundTransparency = 0.15
		end
	end
end

--------------------------------------------------------------------------------
-- curves tab
--------------------------------------------------------------------------------

function Inspector:renderCurves()
	Kit.clear(self.curves)
	local comp = self.store:currentComponent()

	local modeRow = Kit.hlist(self.curves, 4)
	modeRow.Size = UDim2.new(1, 0, 0, 24)
	local modes = {
		{ key = "color", label = "Colour" },
		{ key = "transparency", label = "Opacity" },
		{ key = "size", label = "Size" },
	}
	for _, mode in ipairs(modes) do
		local button = Kit.button(modeRow, mode.label, {
			variant = if self.curveMode == mode.key then "accentSoft" else "ghost",
			height = 22,
			size = UDim2.fromOffset(66, 22),
			textSize = Theme.text.tiny,
			onClick = function()
				self.curveMode = mode.key
				self.activeStop = 1
				self:renderCurves()
			end,
		})
	end

	if not comp then
		Kit.caption(self.curves, "Select a component first.")
		return
	end

	if self.curveMode == "color" then
		self:renderColorEditor(comp)
	else
		self:renderNumberCurve(comp, self.curveMode)
	end
end

function Inspector:renderColorEditor(comp: any)
	local single = self.colorSingle
	local keypoints = sorted(comp.color or {})
	self.activeStop = math.clamp(self.activeStop, 1, math.max(1, #keypoints))

	local header = Kit.hlist(self.curves, 6)
	header.Size = UDim2.new(1, 0, 0, 18)
	Kit.caption(header, "GRADIENT", { Size = UDim2.new(1, -80, 1, 0), Font = Theme.font.bold, TextSize = Theme.text.tiny })
	local countLabel = Kit.caption(header, string.format("%d stops", #keypoints), {
		Size = UDim2.fromOffset(62, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local bar = Kit.frame(self.curves, {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.color.bg0,
	})
	Theme.corner(bar, Theme.radius.xs)
	self.gradientBar = bar

	for index = 1, 40 do
		local alpha = (index - 1) / 39
		Kit.frame(bar, {
			Size = UDim2.new(1 / 40, 1, 1, 0),
			Position = UDim2.fromScale((index - 1) / 40, 0),
			BackgroundColor3 = sampleColor(keypoints, alpha),
		})
	end

	local stopMarkers = {}
	for index, point in ipairs(keypoints) do
		local marker = Kit.frame(bar, {
			Size = UDim2.fromOffset(10, 40),
			Position = UDim2.new(tonumber(point[1]) or 0, -5, 0, 0),
			BackgroundColor3 = if index == self.activeStop then Theme.color.white else Theme.color.black,
			BackgroundTransparency = if index == self.activeStop then 0 else 0.55,
			ZIndex = 3,
		})
		Theme.stroke(marker, if index == self.activeStop then Theme.color.accentBright else Theme.color.white, 1, 0)
		marker.ZIndex = 3

		local click = Instance.new("TextButton")
		click.BackgroundTransparency = 1
		click.Text = ""
		click.Size = UDim2.fromScale(1, 1)
		click.ZIndex = 4
		click.Parent = marker
		click.Activated:Connect(function()
			self.activeStop = index
			self:renderCurves()
		end)

		local startTime = tonumber(point[1]) or 0
		Kit.drag(marker, {
			begin = function()
				self.store:pushHistory("Move colour stop")
				self.activeStop = index
			end,
			move = function(x)
				local fraction = Kit.fractionAlong(bar, x)
				local points = comp.color
				points[index][1] = math.floor(fraction * 1000 + 0.5) / 1000
				self.store:setField(self.store.selection, "color", sorted(points))
			end,
			finish = function()
				comp.color = sorted(comp.color)
				self.store:setField(self.store.selection, "color", comp.color, true)
				self:renderCurves()
			end,
		})

		table.insert(stopMarkers, marker)
	end

	local actions = Kit.hlist(self.curves, 6)
	actions.Size = UDim2.new(1, 0, 0, 24)
	Kit.button(actions, "+ Add stop", {
		variant = "secondary",
		height = 22,
		size = UDim2.fromOffset(80, 22),
		textSize = Theme.text.tiny,
		onClick = function()
			self.store:pushHistory("Add colour stop")
			local points = comp.color
			local insertAt = 0.5
			local color = sampleColor(points, insertAt)
			table.insert(points, { insertAt, Util.toHex(color) })
			comp.color = sorted(points)
			self.activeStop = 1
			self.store:setField(self.store.selection, "color", comp.color)
			self:renderCurves()
		end,
	})
	local removeButton = Kit.button(actions, "Remove stop", {
		variant = "ghost",
		height = 22,
		size = UDim2.fromOffset(80, 22),
		textSize = Theme.text.tiny,
		onClick = function()
			if #comp.color <= 2 then
				self.ctx.toast("A gradient needs at least two stops", "warn")
				return
			end
			self.store:pushHistory("Remove colour stop")
			table.remove(comp.color, self.activeStop)
			self.activeStop = math.clamp(self.activeStop, 1, #comp.color)
			self.store:setField(self.store.selection, "color", comp.color)
			self:renderCurves()
		end,
	})
	removeButton.TextColor3 = Theme.color.bad

	-- HSV picker ----------------------------------------------------------------
	local selected = keypoints[self.activeStop]
	local currentColor = Util.hex(selected and selected[2] or "#ffffff")
	local h, s, v = currentColor:ToHSV()

	local sv = Kit.frame(self.curves, {
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
	})
	Theme.corner(sv, Theme.radius.xs)

	local whiteOverlay = Kit.frame(sv, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
	})
	local whiteGradient = Instance.new("UIGradient")
	whiteGradient.Color = ColorSequence.new(Color3.new(1, 1, 1))
	whiteGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	whiteGradient.Rotation = 0
	whiteGradient.Parent = whiteOverlay

	local blackOverlay = Kit.frame(sv, {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
	})
	local blackGradient = Instance.new("UIGradient")
	blackGradient.Color = ColorSequence.new(Color3.new(0, 0, 0))
	blackGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	blackGradient.Rotation = 90
	blackGradient.Parent = blackOverlay

	local cursor = Kit.frame(sv, {
		Size = UDim2.fromOffset(10, 10),
		Position = UDim2.new(s, -5, 1 - v, -5),
		BackgroundColor3 = currentColor,
		ZIndex = 4,
	})
	Theme.corner(cursor, Theme.radius.pill)
	Theme.stroke(cursor, Theme.color.white, 2, 0)

	local function commitColor(newColor: Color3)
		local points = comp.color
		if not points[self.activeStop] then
			return
		end
		points[self.activeStop][2] = Util.toHex(newColor)
		self.store:setField(self.store.selection, "color", sorted(points))
	end

	local function updateFromPosition(x: number, y: number)
		local sx = Kit.fractionAlong(sv, x)
		local height = math.max(1, sv.AbsoluteSize.Y)
		local sy = 1 - math.clamp((y - sv.AbsolutePosition.Y) / height, 0, 1)
		cursor.Position = UDim2.new(sx, -5, 1 - sy, -5)
		local newColor = Color3.fromHSV(h, sx, sy)
		cursor.BackgroundColor3 = newColor
		commitColor(newColor)
	end

	local svHit = Instance.new("TextButton")
	svHit.BackgroundTransparency = 1
	svHit.Text = ""
	svHit.Size = UDim2.fromScale(1, 1)
	svHit.ZIndex = 3
	svHit.Parent = sv
	Kit.drag(svHit, {
		begin = function(x, y)
			self.store:pushHistory("Pick colour")
			updateFromPosition(x, y)
		end,
		move = function(x, y)
			updateFromPosition(x, y)
		end,
		finish = function()
			self:renderCurves()
		end,
	})

	-- Hue strip
	local hueStrip = Kit.frame(self.curves, {
		Size = UDim2.new(1, 0, 0, 14),
		BackgroundColor3 = Color3.fromHSV(0, 1, 1),
	})
	Theme.corner(hueStrip, Theme.radius.pill)
	local hueGradient = Instance.new("UIGradient")
	hueGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
		ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
		ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
		ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
		ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
		ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
		ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
	})
	hueGradient.Parent = hueStrip

	local hueCursor = Kit.frame(hueStrip, {
		Size = UDim2.new(0, 3, 1, 0),
		Position = UDim2.new(h, -1, 0, 0),
		BackgroundColor3 = Theme.color.white,
		ZIndex = 3,
	})

	local hueHit = Instance.new("TextButton")
	hueHit.BackgroundTransparency = 1
	hueHit.Text = ""
	hueHit.Size = UDim2.fromScale(1, 1)
	hueHit.ZIndex = 2
	hueHit.Parent = hueStrip
	Kit.drag(hueHit, {
		begin = function(x)
			self.store:pushHistory("Pick hue")
		end,
		move = function(x)
			local fraction = Kit.fractionAlong(hueStrip, x)
			h = fraction
			hueCursor.Position = UDim2.new(fraction, -1, 0, 0)
			sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			local newColor = Color3.fromHSV(h, s, v)
			cursor.BackgroundColor3 = newColor
			commitColor(newColor)
		end,
		finish = function()
			self:renderCurves()
		end,
	})

	-- Hex + presets --------------------------------------------------------------
	local hexRow = Kit.hlist(self.curves, 6)
	hexRow.Size = UDim2.new(1, 0, 0, 26)
	Kit.caption(hexRow, "Hex", { Size = UDim2.fromOffset(24, 26) })
	local hexBox = Kit.textBox(hexRow, Util.toHex(currentColor), {
		size = UDim2.new(1, -40, 0, 26),
		onSubmit = function(text)
			local trimmed = Util.trim(text)
			if string.match(trimmed, "^#?%x%x%x%x%x%x$") then
				self.store:pushHistory("Set hex colour")
				commitColor(Util.hex(trimmed))
				self:renderCurves()
			else
				self.ctx.toast("Enter a hex colour like #ff8800", "warn")
				hexBox.Text = Util.toHex(currentColor)
			end
		end,
	})
	hexBox.Parent = hexRow

	Kit.caption(self.curves, "PALETTES", { Size = UDim2.new(1, 0, 0, 14), Font = Theme.font.bold, TextSize = Theme.text.tiny })
	local presetGrid = Kit.frame(self.curves, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	})
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -3, 0, 24)
	grid.CellPadding = UDim2.fromOffset(4, 4)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = presetGrid

	for index, preset in ipairs(COLOR_PRESETS) do
		local button = Kit.button(presetGrid, preset.name, {
			variant = "secondary",
			height = 24,
			size = UDim2.new(1, 0, 0, 24),
			textSize = Theme.text.tiny,
			onClick = function()
				self.store:pushHistory("Apply palette")
				local points = {}
				for stopIndex, hex in ipairs(preset.colors) do
					table.insert(points, { (stopIndex - 1) / (#preset.colors - 1), hex })
				end
				comp.color = points
				self.activeStop = 1
				self.store:setField(self.store.selection, "color", points)
				self:renderCurves()
			end,
		})
		button.LayoutOrder = index
		button.TextXAlignment = Enum.TextXAlignment.Left
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 7)
		pad.Parent = button

		local dots = Kit.hlist(button, 2, {
			Size = UDim2.new(0, 0, 0, 10),
			AutomaticSize = Enum.AutomaticSize.X,
		})
		dots.Position = UDim2.new(1, -34, 0.5, -5)
		for _, hex in ipairs(preset.colors) do
			Kit.colorSwatch(dots, Util.hex(hex), UDim2.fromOffset(9, 9))
		end
	end
end

function Inspector:renderNumberCurve(comp: any, mode: string)
	local key = mode
	local keypoints = comp[key]
	if type(keypoints) ~= "table" then
		Kit.caption(self.curves, "This component has no " .. mode .. " curve.")
		return
	end

	if #keypoints < 2 then
		table.insert(keypoints, { 1, tonumber(keypoints[1] and keypoints[1][2]) or 0 })
	end

	local peak = 1
	if mode == "size" then
		peak = 0.0001
		for _, kp in ipairs(keypoints) do
			peak = math.max(peak, tonumber(kp[2]) or 0)
		end
		peak *= 1.2
	end

	local header = Kit.hlist(self.curves, 6)
	header.Size = UDim2.new(1, 0, 0, 18)
	Kit.caption(header, string.upper(mode == "size" and "SIZE CURVE" or "OPACITY CURVE"), {
		Size = UDim2.new(1, -70, 1, 0),
		Font = Theme.font.bold,
		TextSize = Theme.text.tiny,
	})
	Kit.caption(header, string.format("%d keys", #keypoints), {
		Size = UDim2.fromOffset(60, 18),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local area = Kit.frame(self.curves, {
		Size = UDim2.new(1, 0, 0, 108),
		BackgroundColor3 = Theme.color.bg0,
		ClipsDescendants = false,
	})
	Theme.corner(area, Theme.radius.xs)
	self.curveArea = area

	-- Grid lines
	for index = 1, 4 do
		Kit.frame(area, {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.new(0, 0, index / 4, 0),
			BackgroundColor3 = Theme.color.line,
			BackgroundTransparency = 0.7,
		})
	end

	-- Bars
	for index = 1, 32 do
		local alpha = (index - 1) / 31
		local value = sampleNumber(keypoints, alpha)
		local fraction = math.clamp(if mode == "transparency" then 1 - value else value / peak, 0, 1)
		Kit.frame(area, {
			Size = UDim2.new(1 / 32, 1, math.max(0.004, fraction), 0),
			Position = UDim2.new((index - 1) / 32, 0, 1, 0),
			BackgroundColor3 = if mode == "transparency" then Theme.color.accentBright else Theme.color.accent,
			BackgroundTransparency = 0.35,
			AnchorPoint = Vector2.new(0, 1),
		})
	end

	local function valueFromY(y: number): number
		local height = math.max(1, area.AbsoluteSize.Y)
		local fraction = math.clamp(1 - (y - area.AbsolutePosition.Y) / height, 0, 1)
		if mode == "transparency" then
			return Util.round(1 - fraction, 3)
		end
		return Util.round(fraction * peak, 3)
	end

	for index, kp in ipairs(keypoints) do
		local time = tonumber(kp[1]) or 0
		local value = tonumber(kp[2]) or 0
		local yFraction = if mode == "transparency" then 1 - value else math.clamp(value / peak, 0, 1)

		local dot = Kit.frame(area, {
			Size = UDim2.fromOffset(9, 9),
			Position = UDim2.new(time, -4, 1 - yFraction, -4),
			BackgroundColor3 = Theme.color.white,
			ZIndex = 4,
		})
		Theme.corner(dot, Theme.radius.pill)
		Theme.stroke(dot, Theme.color.accent, 2, 0)

		Kit.drag(dot, {
			begin = function()
				self.store:pushHistory("Edit " .. mode .. " curve")
			end,
			move = function(x, y)
				local newTime = math.clamp(Util.round(Kit.fractionAlong(area, x), 3), 0, 1)
				local newValue = valueFromY(y)
				keypoints[index][1] = newTime
				keypoints[index][2] = newValue
				self.store:setField(self.store.selection, key, keypoints)
			end,
			finish = function()
				comp[key] = sorted(keypoints)
				self.store:setField(self.store.selection, key, comp[key], true)
				self:renderCurves()
			end,
		})
	end

	local hit = Instance.new("TextButton")
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 2
	hit.Parent = area
	hit.Activated:Connect(function()
		local mouse = UserInputService:GetMouseLocation()
		local newTime = math.clamp(Util.round(Kit.fractionAlong(area, mouse.X), 3), 0, 1)
		local newValue = valueFromY(mouse.Y)
		self.store:pushHistory("Add curve key")
		table.insert(keypoints, { newTime, newValue })
		comp[key] = sorted(keypoints)
		self.store:setField(self.store.selection, key, comp[key])
		self:renderCurves()
	end)

	local actions = Kit.hlist(self.curves, 6)
	actions.Size = UDim2.new(1, 0, 0, 24)
	Kit.button(actions, "+ Add key", {
		variant = "secondary",
		height = 22,
		size = UDim2.fromOffset(74, 22),
		textSize = Theme.text.tiny,
		onClick = function()
			self.store:pushHistory("Add curve key")
			local last = keypoints[#keypoints]
			table.insert(keypoints, { 1, tonumber(last and last[2]) or 0 })
			comp[key] = sorted(keypoints)
			self.store:setField(self.store.selection, key, comp[key])
			self:renderCurves()
		end,
	})
	Kit.button(actions, "Reset", {
		variant = "ghost",
		height = 22,
		size = UDim2.fromOffset(52, 22),
		textSize = Theme.text.tiny,
		onClick = function()
			self.store:pushHistory("Reset curve")
			if mode == "transparency" then
				comp[key] = { { 0, 0 }, { 1, 1 } }
			else
				comp[key] = { { 0, 1 }, { 1, 0 } }
			end
			self.store:setField(self.store.selection, key, comp[key])
			self:renderCurves()
		end,
	})

	Kit.caption(self.curves, "Click the graph to add a key, drag keys to shape the curve.", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextSize = Theme.text.tiny,
	})
end

--------------------------------------------------------------------------------
-- cost tab
--------------------------------------------------------------------------------

function Inspector:renderCost()
	Kit.clear(self.cost)
	local report = Performance.analyze(self.store:working())

	local scoreCard = Kit.frame(self.cost, {
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Theme.color.bg2,
	})
	Theme.corner(scoreCard, Theme.radius.md)

	local gradeColor = Theme.color.good
	if report.grade == "B" then
		gradeColor = Theme.color.accentBright
	elseif report.grade == "C" then
		gradeColor = Theme.color.warn
	elseif report.grade == "D" then
		gradeColor = Theme.color.bad
	end

	Kit.label(scoreCard, report.grade, {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.fromOffset(8, 6),
		TextColor3 = gradeColor,
		Font = Theme.font.display,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	Kit.label(scoreCard, string.format("%d / 100", math.floor(report.score)), {
		Size = UDim2.new(1, -76, 0, 18),
		Position = UDim2.fromOffset(66, 10),
		Font = Theme.font.bold,
		TextSize = Theme.text.subtitle,
	})
	Kit.caption(scoreCard, string.format("%d concurrent particles", math.floor(report.alive)), {
		Size = UDim2.new(1, -76, 0, 14),
		Position = UDim2.fromOffset(66, 28),
	})
	local bar = Kit.progressBar(scoreCard, 6)
	bar.track.Position = UDim2.fromOffset(66, 48)
	bar.track.Size = UDim2.new(1, -76, 0, 6)
	bar.Set(report.score / 100, gradeColor)

	local stats = Kit.frame(self.cost, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	})
	local statsLayout = Instance.new("UIListLayout")
	statsLayout.Padding = UDim.new(0, 1)
	statsLayout.Parent = stats

	local rows = {
		{ "Components", tostring(report.components) },
		{ "Emitters", tostring(report.emitters) },
		{ "Peak alive", tostring(math.floor(report.alive)) },
		{ "Burst peak", tostring(math.floor(report.burstPeak)) },
		{ "Beams", tostring(report.beams) },
		{ "Trails", tostring(report.trails) },
		{ "Lights", tostring(report.lights) },
		{ "Parts", tostring(report.parts) },
		{ "Unique textures", tostring(report.textures) },
		{ "Remote textures", tostring(report.remoteTextures), report.remoteTextures > 0 and Theme.color.warn or nil },
	}
	for _, row in ipairs(rows) do
		local stat = Kit.statRow(stats, row[1], row[2], row[3])
		stat.Parent = stats
	end

	Kit.sectionTitle(self.cost, string.format("Issues (%d)", #report.issues))

	if #report.issues == 0 then
		Kit.caption(self.cost, "No problems found. This effect is within a healthy budget.", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextColor3 = Theme.color.good,
		})
	end

	for _, issue in ipairs(report.issues) do
		local card = Kit.frame(self.cost, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.color.bg2,
			ClipsDescendants = false,
		})
		Theme.corner(card, Theme.radius.sm)
		local pad = Instance.new("UIPadding")
		pad.PaddingTop = UDim.new(0, 7)
		pad.PaddingBottom = UDim.new(0, 7)
		pad.PaddingLeft = UDim.new(0, 9)
		pad.PaddingRight = UDim.new(0, 9)
		pad.Parent = card

		local color = if issue.severity == "high" then Theme.color.bad elseif issue.severity == "medium" then Theme.color.warn else Theme.color.accentBright
		local stripe = Kit.frame(card, {
			Size = UDim2.new(0, 2, 1, 0),
			Position = UDim2.fromOffset(0, 0),
			BackgroundColor3 = color,
		})
		Theme.corner(stripe, Theme.radius.pill)

		local body = Kit.vlist(card, 2, {
			Size = UDim2.new(1, -8, 0, 0),
			Position = UDim2.fromOffset(8, 0),
		})
		body.AutomaticSize = Enum.AutomaticSize.Y

		Kit.label(body, issue.title, {
			Size = UDim2.new(1, 0, 0, 15),
			TextColor3 = Theme.color.text,
			TextSize = Theme.text.small,
			Font = Theme.font.medium,
		})
		Kit.caption(body, issue.detail, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		if issue.fix then
			Kit.caption(body, "\u{2192} " .. issue.fix, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextColor3 = Theme.color.textMuted,
				TextYAlignment = Enum.TextYAlignment.Top,
			})
		end
	end

	local actions = Kit.vlist(self.cost, 6)
	actions.Size = UDim2.new(1, 0, 0, 0)
	actions.AutomaticSize = Enum.AutomaticSize.Y

	Kit.button(actions, "Optimise effect", {
		variant = "primary",
		height = 30,
		size = UDim2.new(1, 0, 0, 30),
		onClick = function()
			local optimized, changes = Performance.optimize(self.store:working())
			if not optimized or #changes == 0 then
				self.ctx.toast("Already optimised - nothing to change", "info")
				return
			end
			self.store:pushHistory("Optimise effect")
			self.store.spec = optimized
			self.store.signals:fire("spec")
			self.ctx.toast(string.format("Applied %d optimisation(s)", #changes), "success")
		end,
	})

	Kit.button(actions, "Analyse selection", {
		variant = "secondary",
		height = 28,
		size = UDim2.new(1, 0, 0, 28),
		tooltip = "Score the instances currently selected in Explorer",
		onClick = function()
			local selection = Util.Selection:Get()
			if #selection == 0 then
				self.ctx.toast("Select an effect in the Explorer first", "warn")
				return
			end
			local total = { alive = 0, components = 0, emitters = 0, lights = 0 }
			for _, instance in ipairs(selection) do
				local result = Performance.analyzeInstances(instance)
				total.alive += result.alive
				total.components += result.components
				total.emitters += result.emitters
				total.lights += result.lights
			end
			self.ctx.toast(string.format(
				"Selection: %d emitters, ~%d particles alive",
				total.emitters,
				math.floor(total.alive)
			), "info")
		end,
	})

	Kit.caption(self.cost, "Estimates use emitter rate x average lifetime plus burst peaks. Test on a low-end device before shipping.", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextSize = Theme.text.tiny,
	})
end

function Inspector:destroy()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.root:Destroy()
end

return Inspector
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX37">
				<Properties>
					<string name="Name">Kit</string>
					<bool name="Archivable">true</bool>
					<ProtectedString name="Source"><![CDATA[--[[
	Kit - the widget toolkit every VFX Studio panel is built from.

	Everything here is real interactive UI: buttons with hover animation,
	sliders with drag handling, dropdowns that expand inline, toggles, tabs,
	number fields, tooltips, drag-and-drop, and scroll containers that behave
	inside Roblox Studio's dock widgets.
]]

local Util = require(script.Parent.Parent.Core.Util)
local Theme = require(script.Parent.Parent.Core.Theme)

local UserInputService = game:GetService("UserInputService")

local Kit = {}

Kit.Theme = Theme
Kit.new = Util.new

local overlay: Frame? = nil

--- All tooltips and floating menus render into this full-size overlay.
function Kit.setOverlay(root: Frame?)
	overlay = root
end

local function guard(connection: RBXScriptConnection, object: GuiObject): RBXScriptConnection
	return connection
end

function Kit.disconnectAll(list: { RBXScriptConnection })
	for _, connection in ipairs(list) do
		pcall(function()
			connection:Disconnect()
		end)
	end
end

--------------------------------------------------------------------------------
-- containers
--------------------------------------------------------------------------------

function Kit.frame(parent: Instance, props: { [string]: any }?): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.color.bg2
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	if props then
		for key, value in pairs(props) do
			(frame :: any)[key] = value
		end
	end
	frame.Parent = parent
	return frame
end

function Kit.transparent(parent: Instance, props: { [string]: any }?): Frame
	local frame = Kit.frame(parent, props)
	frame.BackgroundTransparency = 1
	frame.ClipsDescendants = false
	return frame
end

--- ScrollFrame with a vertical list layout and padding baked in.
function Kit.scroll(parent: Instance, props: { [string]: any }?, padding: number?): (ScrollingFrame, Frame)
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Theme.color.lineBright
	scroll.ScrollBarImageTransparency = 0.35
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollingEnabled = true
	scroll.ElasticBehavior = Enum.ElasticBehavior.Never
	if props then
		for key, value in pairs(props) do
			(scroll :: any)[key] = value
		end
	end
	scroll.Parent = parent

	local pad = padding or 10
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.FillDirection = Enum.FillDirection.Vertical
	list.Parent = scroll

	local paddingObject = Instance.new("UIPadding")
	paddingObject.PaddingTop = UDim.new(0, pad)
	paddingObject.PaddingBottom = UDim.new(0, pad + 4)
	paddingObject.PaddingLeft = UDim.new(0, pad)
	paddingObject.PaddingRight = UDim.new(0, pad)
	paddingObject.Parent = scroll

	return scroll, scroll
end

function Kit.hlist(parent: Instance, gap: number?, props: { [string]: any }?): Frame
	local frame = Kit.transparent(parent, props)
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.XY
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, gap or 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Parent = frame
	return frame
end

function Kit.vlist(parent: Instance, gap: number?, props: { [string]: any }?): Frame
	local frame = Kit.transparent(parent, props)
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, gap or 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = frame
	return frame
end

function Kit.divider(parent: Instance, opacity: number?): Frame
	local frame = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.color.line,
		BackgroundTransparency = opacity or 0.35,
	})
	return frame
end

--------------------------------------------------------------------------------
-- text
--------------------------------------------------------------------------------

function Kit.label(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Theme.color.text
	label.Font = Theme.font.body
	label.TextSize = Theme.text.body
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Size = UDim2.new(1, 0, 0, 16)
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.RichText = false
	if props then
		for key, value in pairs(props) do
			(label :: any)[key] = value
		end
	end
	label.Parent = parent
	return label
end

function Kit.caption(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local label = Kit.label(parent, text, {
		TextColor3 = Theme.color.textDim,
		TextSize = Theme.text.small,
		Font = Theme.font.body,
	})
	if props then
		for key, value in pairs(props) do
			(label :: any)[key] = value
		end
	end
	return label
end

function Kit.sectionTitle(parent: Instance, text: string, accessory: GuiObject?): Frame
	local row = Kit.hlist(parent, 8)
	row.Size = UDim2.new(1, 0, 0, 20)
	local label = Kit.label(row, string.upper(text), {
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
		Font = Theme.font.bold,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
	})
	label.LayoutOrder = 1
	if accessory then
		accessory.LayoutOrder = 2
		accessory.Parent = row
	end
	return row
end

--------------------------------------------------------------------------------
-- hover helpers
--------------------------------------------------------------------------------

function Kit.hoverFX(object: GuiObject, normal: Color3, hover: Color3, duration: number?)
	local active = Util.tween
	object.MouseEnter:Connect(function()
		if object.BackgroundColor3 == normal then
			active(object, { BackgroundColor3 = hover }, duration or 0.12)
		end
	end)
	object.MouseLeave:Connect(function()
		if object.BackgroundColor3 == hover then
			active(object, { BackgroundColor3 = normal }, duration or 0.12)
		end
	end)
end

function Kit.tooltip(object: GuiObject, text: string)
	if not text or text == "" then
		return
	end
	local tip: TextLabel? = nil
	object.MouseEnter:Connect(function()
		if not overlay or tip then
			return
		end
		local label = Instance.new("TextLabel")
		label.BackgroundColor3 = Theme.color.bg0
		label.BackgroundTransparency = 0.05
		label.BorderSizePixel = 0
		label.Text = text
		label.TextColor3 = Theme.color.text
		label.Font = Theme.font.body
		label.TextSize = Theme.text.small
		label.TextWrapped = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.AutomaticSize = Enum.AutomaticSize.XY
		label.Size = UDim2.fromOffset(0, 0)
		label.ZIndex = 200
		Theme.corner(label, Theme.radius.sm)
		Theme.stroke(label, Theme.color.lineBright, 1, 0.2)
		local paddingObject = Instance.new("UIPadding")
		paddingObject.PaddingTop = UDim.new(0, 5)
		paddingObject.PaddingBottom = UDim.new(0, 5)
		paddingObject.PaddingLeft = UDim.new(0, 7)
		paddingObject.PaddingRight = UDim.new(0, 7)
		paddingObject.Parent = label
		local constraint = Instance.new("UISizeConstraint")
		constraint.MaxSize = Vector2.new(260, 200)
		constraint.Parent = label
		label.Parent = overlay
		tip = label

		local mouse = UserInputService:GetMouseLocation()
		local rootPosition = overlay.AbsolutePosition
		label.Position = UDim2.fromOffset(mouse.X - rootPosition.X + 14, mouse.Y - rootPosition.Y + 20)
	end)
	object.MouseLeave:Connect(function()
		if tip then
			tip:Destroy()
			tip = nil
		end
	end)
end

--------------------------------------------------------------------------------
-- buttons
--------------------------------------------------------------------------------

export type ButtonOptions = {
	variant: string?,
	width: number?,
	height: number?,
	icon: string?,
	tooltip: string?,
	onClick: (() -> ())?,
	size: UDim2?,
	font: Enum.Font?,
	textSize: number?,
}

function Kit.button(parent: Instance, text: string, options: ButtonOptions?): TextButton
	local opts = options or {}
	local variant = opts.variant or "secondary"
	local height = opts.height or 28

	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.Font = opts.font or Theme.font.medium
	button.TextSize = opts.textSize or Theme.text.body
	button.TextColor3 = Theme.color.text
	button.Text = text
	button.Size = opts.size or UDim2.new(opts.width and 0 or 1, opts.width or 0, 0, height)
	button.BackgroundColor3 = Theme.color.bg3
	button.ClipsDescendants = true

	if variant == "primary" then
		button.BackgroundColor3 = Theme.color.accent
		button.TextColor3 = Theme.color.white
		button.Font = Theme.font.bold
	elseif variant == "ghost" then
		button.BackgroundTransparency = 1
		button.TextColor3 = Theme.color.textDim
	elseif variant == "danger" then
		button.BackgroundColor3 = Theme.color.badSoft
		button.TextColor3 = Theme.color.bad
	elseif variant == "accentSoft" then
		button.BackgroundColor3 = Theme.color.accentSoft
		button.TextColor3 = Theme.color.accentBright
	end

	Theme.corner(button, Theme.radius.sm)
	button.Parent = parent

	local normalColor = button.BackgroundColor3
	local hoverColor = if variant == "primary"
		then Theme.color.accentBright
		elseif variant == "ghost"
		then Theme.color.bg3
		elseif variant == "danger"
		then Theme.color.bad
		else Theme.color.bg4

	button.MouseEnter:Connect(function()
		if variant == "ghost" then
			button.BackgroundTransparency = 0
		end
		Util.tween(button, { BackgroundColor3 = hoverColor }, 0.1)
	end)
	button.MouseLeave:Connect(function()
		Util.tween(button, { BackgroundColor3 = normalColor }, 0.12)
		if variant == "ghost" then
			Util.tween(button, { BackgroundTransparency = 1 }, 0.12)
		end
	end)

	if opts.onClick then
		button.Activated:Connect(function()
			local ok, err = pcall(opts.onClick :: () -> ())
			if not ok then
				warn("[VFX Studio] button error: " .. tostring(err))
			end
		end)
	end
	if opts.tooltip then
		Kit.tooltip(button, opts.tooltip)
	end
	return button
end

function Kit.iconButton(parent: Instance, glyph: string, options: ButtonOptions?): TextButton
	local opts = options or {}
	local button = Kit.button(parent, glyph, {
		variant = opts.variant or "ghost",
		size = opts.size or UDim2.fromOffset(opts.width or 26, opts.height or 26),
		onClick = opts.onClick,
		tooltip = opts.tooltip,
		font = Theme.font.bold,
		textSize = opts.textSize or 14,
	})
	button.TextColor3 = if opts.variant == "primary" then Theme.color.white else Theme.color.textDim
	return button
end

--------------------------------------------------------------------------------
-- inputs
--------------------------------------------------------------------------------

function Kit.searchBox(parent: Instance, placeholder: string, onChange: (string) -> (), width: UDim2?): TextBox
	local container = Kit.frame(parent, {
		Size = width or UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.color.bg1,
	})
	Theme.corner(container, Theme.radius.sm)
	Theme.stroke(container, Theme.color.line, 1, 0.3)

	local icon = Kit.label(container, "\u{2315}", {
		Size = UDim2.fromOffset(26, 30),
		Position = UDim2.fromOffset(6, 0),
		TextColor3 = Theme.color.textMuted,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	local box = Instance.new("TextBox")
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -34, 1, 0)
	box.Position = UDim2.fromOffset(30, 0)
	box.ClearTextOnFocus = false
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = Theme.color.textMuted
	box.TextColor3 = Theme.color.text
	box.Font = Theme.font.body
	box.TextSize = Theme.text.body
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Text = ""
	box.Parent = container

	box:GetPropertyChangedSignal("Text"):Connect(function()
		local ok, err = pcall(onChange, box.Text)
		if not ok then
			warn("[VFX Studio] search error: " .. tostring(err))
		end
	end)
	box.Focused:Connect(function()
		Theme.stroke(container, Theme.color.accent, 1, 0)
	end)
	box.FocusLost:Connect(function()
		Theme.stroke(container, Theme.color.line, 1, 0.3)
	end)
	return box
end

function Kit.textBox(parent: Instance, value: string, options: any?): TextBox
	local opts = options or {}
	local box = Instance.new("TextBox")
	box.BackgroundColor3 = Theme.color.bg1
	box.BorderSizePixel = 0
	box.Size = opts.size or UDim2.new(1, 0, 0, opts.height or 26)
	box.ClearTextOnFocus = false
	box.Text = value or ""
	box.PlaceholderText = opts.placeholder or ""
	box.PlaceholderColor3 = Theme.color.textMuted
	box.TextColor3 = Theme.color.text
	box.Font = opts.font or Theme.font.body
	box.TextSize = opts.textSize or Theme.text.body
	box.TextXAlignment = opts.align or Enum.TextXAlignment.Left
	box.TextTruncate = Enum.TextTruncate.AtEnd
	box.Parent = parent
	Theme.corner(box, Theme.radius.xs)

	local paddingObject = Instance.new("UIPadding")
	paddingObject.PaddingLeft = UDim.new(0, 8)
	paddingObject.PaddingRight = UDim.new(0, 8)
	paddingObject.Parent = box

	if opts.onSubmit then
		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				local ok, err = pcall(opts.onSubmit, box.Text)
				if not ok then
					warn("[VFX Studio] input error: " .. tostring(err))
				end
			end
		end)
	end
	return box
end

--- Numeric field with commit-on-enter and optional drag-free steppers.
function Kit.numberBox(parent: Instance, value: number, options: any?): (Frame, any)
	local opts = options or {}
	local wrapper = Kit.frame(parent, {
		Size = opts.size or UDim2.fromOffset(64, 26),
		BackgroundColor3 = Theme.color.bg1,
	})
	Theme.corner(wrapper, Theme.radius.xs)
	Theme.stroke(wrapper, Theme.color.line, 1, 0.45)

	local box = Instance.new("TextBox")
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -8, 1, 0)
	box.Position = UDim2.fromOffset(4, 0)
	box.ClearTextOnFocus = false
	box.Text = tostring(Util.round(value, 3))
	box.TextColor3 = Theme.color.text
	box.Font = Theme.font.mono
	box.TextSize = Theme.text.small
	box.TextXAlignment = if opts.align == "right" then Enum.TextXAlignment.Right else Enum.TextXAlignment.Center
	box.Parent = wrapper

	local api = { value = value }

	local function commit(text: string)
		local parsed = tonumber(text)
		if parsed == nil then
			box.Text = tostring(Util.round(api.value, 3))
			return
		end
		if opts.min then
			parsed = math.max(opts.min, parsed)
		end
		if opts.max then
			parsed = math.min(opts.max, parsed)
		end
		api.value = parsed
		box.Text = tostring(Util.round(parsed, 3))
		if opts.onChange then
			local ok, err = pcall(opts.onChange, parsed)
			if not ok then
				warn("[VFX Studio] number field error: " .. tostring(err))
			end
		end
	end

	box.FocusLost:Connect(function(enterPressed)
		commit(box.Text)
	end)

	function api.Set(newValue: number)
		api.value = newValue
		box.Text = tostring(Util.round(newValue, 3))
	end

	function api.Get(): number
		return api.value
	end

	return wrapper, api
end

export type SliderOptions = {
	min: number?,
	max: number?,
	step: number?,
	value: number?,
	onChange: ((number) -> ())?,
	onStart: (() -> ())?,
	onFinish: (() -> ())?,
	height: number?,
	showValue: boolean?,
	format: ((number) -> string)?,
}

function Kit.slider(parent: Instance, options: SliderOptions): any
	local opts = options
	local min = opts.min or 0
	local max = opts.max or 1
	if max <= min then
		max = min + 1
	end
	local step = opts.step or 0
	local value = math.clamp(opts.value or min, min, max)

	local container = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 0, opts.height or 22),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})

	local track = Kit.frame(container, {
		Size = UDim2.new(1, -46, 0, 5),
		Position = UDim2.new(0, 0, 0.5, -2),
		BackgroundColor3 = Theme.color.bg4,
	})
	Theme.corner(track, Theme.radius.pill)

	local fill = Kit.frame(track, {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.color.accent,
	})
	Theme.corner(fill, Theme.radius.pill)

	local knob = Kit.frame(container, {
		Size = UDim2.fromOffset(11, 11),
		Position = UDim2.new(0, 0, 0.5, -5),
		BackgroundColor3 = Theme.color.white,
	})
	Theme.corner(knob, Theme.radius.pill)

	local valueLabel = Kit.label(container, "", {
		Size = UDim2.new(0, 42, 1, 0),
		Position = UDim2.new(1, -42, 0, 0),
		TextColor3 = Theme.color.textDim,
		Font = Theme.font.mono,
		TextSize = Theme.text.small,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local api = { value = value }
	local dragging = false

	local function format(v: number): string
		if opts.format then
			return opts.format(v)
		end
		return Util.pretty(v)
	end

	local function applyVisual(newValue: number)
		local alpha = (newValue - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, -5, 0.5, -5)
		valueLabel.Text = format(newValue)
	end

	local function quantize(raw: number): number
		local clamped = math.clamp(raw, min, max)
		if step > 0 then
			clamped = min + math.floor((clamped - min) / step + 0.5) * step
		end
		return math.clamp(clamped, min, max)
	end

	local function setFromInput(inputX: number)
		local absolute = track.AbsolutePosition.X
		local width = math.max(1, track.AbsoluteSize.X)
		local alpha = math.clamp((inputX - absolute) / width, 0, 1)
		local newValue = quantize(min + alpha * (max - min))
		if newValue == api.value then
			return
		end
		api.value = newValue
		applyVisual(newValue)
		if opts.onChange then
			local ok, err = pcall(opts.onChange, newValue)
			if not ok then
				warn("[VFX Studio] slider error: " .. tostring(err))
			end
		end
	end

	local hitArea = Kit.frame(container, {
		Size = UDim2.new(1, -46, 1, 0),
		BackgroundTransparency = 1,
	})
	hitArea.ZIndex = 3

	hitArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			if opts.onStart then
				opts.onStart()
			end
			setFromInput(input.Position.X)
		end
	end)

	local moveConnection: RBXScriptConnection
	moveConnection = UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromInput(input.Position.X)
		end
	end)
	local endConnection: RBXScriptConnection
	endConnection = UserInputService.InputEnded:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
			if opts.onFinish then
				opts.onFinish()
			end
		end
	end)

	container.AncestryChanged:Connect(function()
		if not container.Parent then
			moveConnection:Disconnect()
			endConnection:Disconnect()
		end
	end)

	function api.Set(newValue: number)
		api.value = quantize(newValue)
		applyVisual(api.value)
	end

	function api.Get(): number
		return api.value
	end

	applyVisual(value)
	return api
end

--------------------------------------------------------------------------------
-- dropdown
--------------------------------------------------------------------------------

export type DropdownOptions = {
	options: { any },
	value: any?,
	onChange: ((any) -> ())?,
	placeholder: string?,
	height: number?,
	maxHeight: number?,
}

--- Inline-expanding dropdown (no clipping issues inside scroll frames).
function Kit.dropdown(parent: Instance, options: DropdownOptions): any
	local opts = options
	local choices = opts.options or {}
	local current = opts.value

	local container = Kit.vlist(parent, 2)
	container.Size = UDim2.new(1, 0, 0, 0)

	local button = Kit.button(container, "", {
		variant = "secondary",
		height = opts.height or 26,
		size = UDim2.new(1, 0, 0, opts.height or 26),
	})
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Text = ""

	local paddingObject = Instance.new("UIPadding")
	paddingObject.PaddingLeft = UDim.new(0, 9)
	paddingObject.Parent = button

	local caret = Kit.label(button, "\u{25be}", {
		Size = UDim2.new(0, 18, 1, 0),
		Position = UDim2.new(1, -20, 0, 0),
		TextColor3 = Theme.color.textMuted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 12,
	})

	local list = Kit.frame(container, {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Theme.color.bg1,
		Visible = false,
	})
	Theme.corner(list, Theme.radius.sm)
	Theme.stroke(list, Theme.color.line, 1, 0.25)

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 1)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list

	local listPadding = Instance.new("UIPadding")
	listPadding.PaddingTop = UDim.new(0, 4)
	listPadding.PaddingBottom = UDim.new(0, 4)
	listPadding.PaddingLeft = UDim.new(0, 4)
	listPadding.PaddingRight = UDim.new(0, 4)
	listPadding.Parent = list

	local scroller = Instance.new("ScrollingFrame")
	scroller.BackgroundTransparency = 1
	scroller.BorderSizePixel = 0
	scroller.ScrollBarThickness = 3
	scroller.Size = UDim2.new(1, 0, 1, 0)
	scroller.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroller.ScrollingDirection = Enum.ScrollingDirection.Y
	scroller.Parent = list

	local scrollerLayout = Instance.new("UIListLayout")
	scrollerLayout.Padding = UDim.new(0, 1)
	scrollerLayout.Parent = scroller

	local api = { value = current, open = false }

	local function labelFor(value: any): string
		for _, choice in ipairs(choices) do
			if choice.value == value then
				return choice.label or tostring(choice.value)
			end
		end
		return opts.placeholder or "Select..."
	end

	local function render()
		for _, child in ipairs(scroller:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local count = 0
		for _, choice in ipairs(choices) do
			count += 1
			local selected = choice.value == api.value
			local option = Kit.button(scroller, choice.label or tostring(choice.value), {
				variant = if selected then "accentSoft" else "ghost",
				height = 24,
				size = UDim2.new(1, -4, 0, 24),
				textSize = Theme.text.small,
				onClick = function()
					api.value = choice.value
					button.Text = labelFor(api.value)
					api.open = false
					list.Visible = false
					if opts.onChange then
						opts.onChange(choice.value)
					end
					render()
				end,
			})
			option.TextXAlignment = Enum.TextXAlignment.Left
			option.LayoutOrder = count
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 8)
			pad.Parent = option
		end
		list.Size = UDim2.new(1, 0, 0, math.min(opts.maxHeight or 160, 32 + count * 25))
		list.Visible = api.open
		scroller.CanvasSize = UDim2.new(0, 0, 0, count * 25)
	end

	button.Text = labelFor(api.value)
	button.Activated:Connect(function()
		api.open = not api.open
		list.Visible = api.open
		if api.open then
			render()
		end
	end)

	function api.Set(value: any)
		api.value = value
		button.Text = labelFor(value)
		if api.open then
			render()
		end
	end

	function api.Get(): any
		return api.value
	end

	render()
	list.Visible = false
	return api
end

--------------------------------------------------------------------------------
-- toggle
--------------------------------------------------------------------------------

function Kit.toggle(parent: Instance, value: boolean, onChange: ((boolean) -> ())?): any
	local track = Kit.frame(parent, {
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = if value then Theme.color.accent else Theme.color.bg4,
	})
	Theme.corner(track, Theme.radius.pill)

	local knob = Kit.frame(track, {
		Size = UDim2.fromOffset(14, 14),
		Position = if value then UDim2.new(1, -16, 0.5, -7) else UDim2.fromOffset(2, 2),
		BackgroundColor3 = Theme.color.white,
	})
	Theme.corner(knob, Theme.radius.pill)

	local button = Kit.frame(track, {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	})
	button.ZIndex = 2

	local api = { value = value }
	local click = Instance.new("TextButton")
	click.BackgroundTransparency = 1
	click.Text = ""
	click.Size = UDim2.fromScale(1, 1)
	click.ZIndex = 3
	click.Parent = track

	local function apply(newValue: boolean)
		api.value = newValue
		Util.tween(track, { BackgroundColor3 = if newValue then Theme.color.accent else Theme.color.bg4 }, 0.12)
		knob.Position = if newValue then UDim2.new(1, -16, 0.5, -7) else UDim2.fromOffset(2, 2)
	end

	click.Activated:Connect(function()
		apply(not api.value)
		if onChange then
			onChange(api.value)
		end
	end)

	function api.Set(newValue: boolean)
		apply(newValue)
	end

	function api.Get(): boolean
		return api.value
	end

	return api
end

--------------------------------------------------------------------------------
-- labelled row helper
--------------------------------------------------------------------------------

--- Row with a label on the left and an arbitrary control on the right.
function Kit.row(parent: Instance, labelText: string, tooltipText: string?, height: number?): Frame
	local row = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 0, height or 26),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	local label = Kit.label(row, labelText, {
		Size = UDim2.new(0.52, -6, 1, 0),
		TextColor3 = Theme.color.textDim,
		TextSize = Theme.text.small,
	})
	if tooltipText then
		Kit.tooltip(label, tooltipText)
	end
	local holder = Kit.frame(row, {
		Size = UDim2.new(0.48, -6, 1, 0),
		Position = UDim2.new(0.52, 6, 0, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	return row, holder
end

function Kit.badge(parent: Instance, text: string, color: Color3?): Frame
	local bg = color or Theme.color.bg4
	local pill = Kit.frame(parent, {
		Size = UDim2.fromOffset(0, 18),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = bg,
		BackgroundTransparency = 0.55,
		ClipsDescendants = false,
	})
	Theme.corner(pill, Theme.radius.pill)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 7)
	pad.PaddingRight = UDim.new(0, 7)
	pad.Parent = pill
	local label = Kit.label(pill, text, {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		TextColor3 = Theme.color.text,
		TextSize = Theme.text.tiny,
		Font = Theme.font.bold,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	return pill
end

--------------------------------------------------------------------------------
-- drag helper
--------------------------------------------------------------------------------

export type DragCallbacks = {
	begin: ((number, number) -> ())?,
	move: ((number, number) -> ())?,
	finish: ((number, number) -> ())?,
}

--- Mouse drag tracking for a GuiObject. Coordinates are absolute screen pixels.
function Kit.drag(object: GuiObject, callbacks: DragCallbacks)
	local dragging = false
	local startX, startY = 0, 0

	local beginConnection = object.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = true
		startX = input.Position.X
		startY = input.Position.Y
		if callbacks.begin then
			callbacks.begin(startX, startY)
		end
	end)

	local moveConnection = UserInputService.InputChanged:Connect(function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end
		if callbacks.move then
			callbacks.move(input.Position.X, input.Position.Y)
		end
	end)

	local endConnection = UserInputService.InputEnded:Connect(function(input)
		if not dragging or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		dragging = false
		if callbacks.finish then
			callbacks.finish(input.Position.X, input.Position.Y)
		end
	end)

	object.AncestryChanged:Connect(function()
		if not object.Parent then
			beginConnection:Disconnect()
			moveConnection:Disconnect()
			endConnection:Disconnect()
		end
	end)
end

--- Converts a mouse X coordinate into 0..1 along a GuiObject.
function Kit.fractionAlong(object: GuiObject, mouseX: number): number
	local width = math.max(1, object.AbsoluteSize.X)
	return math.clamp((mouseX - object.AbsolutePosition.X) / width, 0, 1)
end

--------------------------------------------------------------------------------
-- misc
--------------------------------------------------------------------------------

function Kit.progressBar(parent: Instance, height: number?): any
	local track = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 0, height or 6),
		BackgroundColor3 = Theme.color.bg4,
	})
	Theme.corner(track, Theme.radius.pill)
	local fill = Kit.frame(track, {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.color.accent,
	})
	Theme.corner(fill, Theme.radius.pill)
	local api = { track = track, fill = fill }
	function api.Set(fraction: number, color: Color3?)
		fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return api
end

function Kit.chip(parent: Instance, text: string, onClick: (() -> ())?, active: boolean?): TextButton
	local button = Kit.button(parent, text, {
		variant = if active then "accentSoft" else "secondary",
		height = 22,
		width = 0,
		size = UDim2.fromOffset(0, 22),
		textSize = Theme.text.tiny,
		onClick = onClick,
	})
	button.AutomaticSize = Enum.AutomaticSize.X
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 9)
	pad.PaddingRight = UDim.new(0, 9)
	pad.Parent = button
	return button
end

function Kit.clear(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") and not child:IsA("UIGradient") then
			child:Destroy()
		end
	end
end

function Kit.applyListPadding(scroll: ScrollingFrame, amount: number)
	local existing = scroll:FindFirstChildOfClass("UIPadding")
	if existing then
		existing.PaddingTop = UDim.new(0, amount)
		existing.PaddingBottom = UDim.new(0, amount + 4)
		existing.PaddingLeft = UDim.new(0, amount)
		existing.PaddingRight = UDim.new(0, amount)
	end
end

function Kit.colorSwatch(parent: Instance, color: Color3, size: UDim2?): Frame
	local swatch = Kit.frame(parent, {
		Size = size or UDim2.fromOffset(18, 18),
		BackgroundColor3 = color,
	})
	Theme.corner(swatch, Theme.radius.xs)
	Theme.stroke(swatch, Theme.color.black, 1, 0.7)
	return swatch
end

--- Small key/value stat line used by the cost panel and export dialog.
function Kit.statRow(parent: Instance, labelText: string, valueText: string, color: Color3?): Frame
	local row = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	Kit.caption(row, labelText, { Size = UDim2.new(0.6, 0, 1, 0) })
	Kit.label(row, valueText, {
		Size = UDim2.new(0.4, 0, 1, 0),
		Position = UDim2.new(0.6, 0, 0, 0),
		TextColor3 = color or Theme.color.text,
		Font = Theme.font.mono,
		TextSize = Theme.text.small,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	return row
end

return Kit
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX38">
				<Properties>
					<string name="Name">Library</string>
					<bool name="Archivable">true</bool>
					<ProtectedString name="Source"><![CDATA[--[[
	Library - the preset browser.

	Categories, instant search, favourites, "my presets" and a paged card grid
	with thumbnails generated from each effect's real texture and palette.
	324 presets are paged 24 at a time so the panel stays instant in Studio.
]]

local Util = require(script.Parent.Parent.Core.Util)
local Theme = require(script.Parent.Parent.Core.Theme)
local Assets = require(script.Parent.Parent.Core.Assets)
local Kit = require(script.Parent.Kit)

local Library = {}
Library.__index = Library

local PAGE_SIZE = 24

local function primaryTexture(spec: any): (string, Color3, Color3)
	local texture = Assets.defaultUri
	local firstColor = Theme.color.accent
	local lastColor = Theme.color.accentDeep

	for _, comp in ipairs(spec.components or {}) do
		if comp.kind == "particle" then
			texture = Assets.resolve(comp.texture)
			local points = comp.color or {}
			if #points > 0 then
				firstColor = Util.hex(points[1][2] or "#ffffff")
				lastColor = Util.hex(points[#points][2] or "#ffffff")
			end
			break
		end
	end
	return texture, firstColor, lastColor
end

local function glyphFor(spec: any): string
	local hasParticle, hasBeam, hasTrail, hasLight = false, false, false, false
	for _, comp in ipairs(spec.components or {}) do
		if comp.kind == "particle" then
			hasParticle = true
		elseif comp.kind == "beam" then
			hasBeam = true
		elseif comp.kind == "trail" then
			hasTrail = true
		elseif comp.kind == "light" then
			hasLight = true
		end
	end
	if hasBeam then
		return "\u{2726}"
	elseif hasTrail then
		return "\u{2192}"
	elseif hasLight then
		return "\u{2600}"
	elseif hasParticle then
		return "\u{273b}"
	end
	return "\u{25c6}"
end

function Library.new(parent: Instance, ctx: any)
	local self = setmetatable({}, Library)
	self.ctx = ctx
	self.store = ctx.store
	self.query = ""
	self.category = "All"
	self.page = 1
	self.showFavoritesOnly = false
	self.cards = {}

	local root = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.color.bg1,
	})
	self.root = root

	-- header ------------------------------------------------------------------
	local header = Kit.frame(root, {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	local title = Kit.label(header, "VFX Library", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -100, 0, 16),
		Font = Theme.font.bold,
		TextSize = Theme.text.title,
	})
	self.countLabel = Kit.label(header, "", {
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -100, 0, 14),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
	})
	local favButton = Kit.iconButton(header, "\u{2605}", {
		size = UDim2.fromOffset(26, 26),
		tooltip = "Show favourites only",
		onClick = function()
			self.showFavoritesOnly = not self.showFavoritesOnly
			favButton.TextColor3 = if self.showFavoritesOnly then Theme.color.warn else Theme.color.textDim
			self.page = 1
			self:refresh()
		end,
	})
	favButton.Position = UDim2.new(1, -34, 0, 10)
	self.favButton = favButton

	-- search ------------------------------------------------------------------
	local searchHolder = Kit.frame(root, {
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(12, 48),
		BackgroundTransparency = 1,
	})
	self.search = Kit.searchBox(searchHolder, "Search 324 effects, tags, categories...", function(text)
		self.query = text
		self.page = 1
		self:refresh()
	end)

	-- categories --------------------------------------------------------------
	local categoryScroll = Kit.scroll(root, {
		Size = UDim2.new(1, 0, 0, 116),
		Position = UDim2.fromOffset(0, 84),
	}, 6)
	categoryScroll.ScrollBarThickness = 3
	self.categoryHolder = categoryScroll
	categoryScroll.ClipsDescendants = true

	local categoryList = Kit.frame(categoryScroll, {
		Size = UDim2.new(1, -10, 0, 0),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	self.categoryList = categoryList

	-- results -----------------------------------------------------------------
	local resultHeader = Kit.frame(root, {
		Size = UDim2.new(1, -24, 0, 22),
		Position = UDim2.fromOffset(12, 206),
		BackgroundTransparency = 1,
	})
	self.resultHeader = resultHeader
	self.resultLabel = Kit.label(resultHeader, "", {
		Size = UDim2.new(1, -80, 1, 0),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
		Font = Theme.font.bold,
	})
	self.sortLabel = Kit.label(resultHeader, "A-Z", {
		Size = UDim2.fromOffset(50, 20),
		Position = UDim2.new(1, -50, 0, 1),
		TextColor3 = Theme.color.textFaint,
		TextSize = Theme.text.tiny,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	local gridScroll, gridContent = Kit.scroll(root, {
		Size = UDim2.new(1, 0, 1, -232),
		Position = UDim2.fromOffset(0, 230),
	}, 8)
	self.gridScroll = gridScroll

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.5, -7, 0, 96)
	grid.CellPadding = UDim2.fromOffset(6, 6)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.FillDirectionMaxCells = 2
	grid.Parent = gridScroll
	self.gridLayout = grid

	-- load more --------------------------------------------------------------
	self.moreButton = Kit.button(root, "Load more effects", {
		variant = "secondary",
		height = 26,
		size = UDim2.new(1, -24, 0, 26),
		onClick = function()
			self.page += 1
			self:renderGrid(true)
		end,
	})
	self.moreButton.Position = UDim2.new(0, 12, 1, -34)
	self.moreButton.Visible = false

	self.signals = {}
	self:bindStore()
	self:refreshCategories()
	self:refresh()
	return self
end

function Library:bindStore()
	local connections = {}
	table.insert(connections, self.store.signals:on("custom", function()
		self:refreshCategories()
		self:refresh()
	end))
	table.insert(connections, self.store.signals:on("favorites", function()
		self:refreshCategories()
		self:refresh()
	end))
	table.insert(connections, self.store.signals:on("pref", function(payload)
		if payload.key == "lastPresetId" then
			self:refreshSelection()
		end
	end))
	self.connections = connections
end

function Library:refreshCategories()
	Kit.clear(self.categoryList)
	local categories = self.store:categories()
	local index = 0
	for _, category in ipairs(categories) do
		index += 1
		local active = self.category == category.name
		local row = Kit.button(self.categoryList, "", {
			variant = if active then "accentSoft" else "ghost",
			height = 24,
			size = UDim2.new(1, 0, 0, 24),
			onClick = function()
				self.category = category.name
				self.page = 1
				self:refreshCategories()
				self:refresh()
			end,
		})
		row.LayoutOrder = index
		row.TextXAlignment = Enum.TextXAlignment.Left

		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 9)
		pad.Parent = row

		Kit.label(row, category.label or category.name, {
			Size = UDim2.new(1, -38, 1, 0),
			TextColor3 = if active then Theme.color.text else Theme.color.textDim,
			TextSize = Theme.text.small,
			Font = if active then Theme.font.medium else Theme.font.body,
		})

		local countText = tostring(category.count or 0)
		Kit.label(row, countText, {
			Size = UDim2.fromOffset(30, 24),
			Position = UDim2.new(1, -34, 0, 0),
			TextColor3 = Theme.color.textFaint,
			TextSize = Theme.text.tiny,
			TextXAlignment = Enum.TextXAlignment.Right,
			Font = Theme.font.mono,
		})
	end
end

function Library:refresh()
	self:renderGrid(false)
	self:refreshSelection()
end

function Library:refreshSelection()
	for id, card in pairs(self.cards) do
		local active = self.store.prefs.lastPresetId == id
		card.stroke.Color = if active then Theme.color.accent else Theme.color.line
		card.stroke.Thickness = if active then 2 else 1
		card.stroke.Transparency = if active then 0 else 0.45
		card.frame.BackgroundColor3 = if active then Theme.color.bg3 else Theme.color.bg2
	end
end

function Library:renderGrid(append: boolean)
	if not append then
		Kit.clear(self.gridScroll)
		self.cards = {}
	end

	local results = self.store:search(self.query, {
		category = self.category,
		favoritesOnly = self.showFavoritesOnly,
	})

	self.countLabel.Text = string.format("%d effects - %d categories", #self.store.presets.all + #self.store.custom, #self.store.presets.categories)
	self.resultLabel.Text = string.upper(self.category == "All" and "All effects" or self.category) .. "  \u{00b7}  " .. #results .. " results"

	local limit = math.min(#results, self.page * PAGE_SIZE)
	local start = if append then (self.page - 1) * PAGE_SIZE + 1 else 1

	if #results == 0 then
		if not append then
			local empty = Kit.label(self.gridScroll, "No effects match this search.\nTry a tag like \"fire\", \"magic\" or \"impact\".", {
				Size = UDim2.new(1, -10, 0, 60),
				TextColor3 = Theme.color.textMuted,
				TextWrapped = true,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextSize = Theme.text.small,
			})
			empty.LayoutOrder = 1
		end
		self.moreButton.Visible = false
		return
	end

	for index = start, limit do
		local spec = results[index]
		if spec then
			self:createCard(spec, index)
		end
	end

	self.moreButton.Visible = limit < #results
	self.moreButton.Text = string.format("Load %d more", math.min(PAGE_SIZE, #results - limit))
end

function Library:createCard(spec: any, order: number)
	local texture, colorA, colorB = primaryTexture(spec)

	local cardFrame = Kit.frame(self.gridScroll, {
		Size = UDim2.new(0, 130, 0, 96),
		BackgroundColor3 = if self.store.prefs.lastPresetId == spec.id then Theme.color.bg3 else Theme.color.bg2,
		ClipsDescendants = true,
	})
	cardFrame.LayoutOrder = order
	local stroke = Theme.stroke(cardFrame, Theme.color.line, 1, 0.45)
	Theme.corner(cardFrame, Theme.radius.md)

	local thumb = Kit.frame(cardFrame, {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = Theme.color.bg0,
	})
	local thumbGradient = Instance.new("UIGradient")
	thumbGradient.Color = ColorSequence.new(Theme.shade(colorB, 0.55), Theme.color.bg0)
	thumbGradient.Rotation = 115
	thumbGradient.Parent = thumb

	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.new(1, -14, 1, -8)
	image.Position = UDim2.fromOffset(7, 2)
	image.Image = texture
	image.ImageColor3 = colorA
	image.ImageTransparency = 0.05
	image.ScaleType = Enum.ScaleType.Fit
	image.Parent = thumb

	local glow = Instance.new("ImageLabel")
	glow.BackgroundTransparency = 1
	glow.Size = UDim2.new(1, -6, 1, -6)
	glow.Position = UDim2.fromOffset(3, 3)
	glow.Image = texture
	glow.ImageColor3 = colorA
	glow.ImageTransparency = 0.62
	glow.ScaleType = Enum.ScaleType.Fit
	glow.Parent = thumb

	local glyph = Kit.label(thumb, glyphFor(spec), {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(6, 5),
		TextColor3 = Theme.color.white,
		TextTransparency = 0.35,
		TextSize = 11,
		Font = Theme.font.bold,
	})

	local nameLabel = Kit.label(cardFrame, spec.name, {
		Size = UDim2.new(1, -12, 0, 16),
		Position = UDim2.fromOffset(8, 55),
		TextSize = Theme.text.small,
		Font = Theme.font.medium,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local meta = Kit.label(cardFrame, string.format("%s  \u{00b7}  %ds", spec.category, math.max(1, math.floor(spec.duration + 0.5))), {
		Size = UDim2.new(1, -12, 0, 13),
		Position = UDim2.fromOffset(8, 70),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local star = Kit.iconButton(cardFrame, if self.store:isFavorite(spec.id) then "\u{2605}" else "\u{2606}", {
		size = UDim2.fromOffset(20, 20),
		tooltip = "Favourite",
		onClick = function()
			self.store:toggleFavorite(spec.id)
			star.Text = if self.store:isFavorite(spec.id) then "\u{2605}" else "\u{2606}"
			star.TextColor3 = if self.store:isFavorite(spec.id) then Theme.color.warn else Theme.color.textDim
		end,
	})
	star.Position = UDim2.new(1, -24, 0, 57)
	star.TextColor3 = if self.store:isFavorite(spec.id) then Theme.color.warn else Theme.color.textDim
	star.ZIndex = 3

	local click = Instance.new("TextButton")
	click.BackgroundTransparency = 1
	click.Text = ""
	click.Size = UDim2.new(1, 0, 1, 0)
	click.ZIndex = 2
	click.Parent = cardFrame

	local hoverTween = function(target: Vector2?)
		Util.tween(cardFrame, { BackgroundColor3 = Theme.color.bg3 }, 0.1)
		Util.tween(image, { ImageTransparency = 0 }, 0.12)
		Util.tween(glow, { ImageTransparency = 0.4 }, 0.12)
	end
	local leaveTween = function()
		Util.tween(cardFrame, { BackgroundColor3 = if self.store.prefs.lastPresetId == spec.id then Theme.color.bg3 else Theme.color.bg2 }, 0.12)
		Util.tween(image, { ImageTransparency = 0.05 }, 0.12)
		Util.tween(glow, { ImageTransparency = 0.62 }, 0.12)
	end

	click.MouseEnter:Connect(hoverTween)
	click.MouseLeave:Connect(leaveTween)

	click.Activated:Connect(function()
		local ok, err = pcall(function()
			self.store:applyPreset(spec)
			self.ctx.toast("Loaded " .. spec.name)
			self:refreshSelection()
		end)
		if not ok then
			warn("[VFX Studio] could not load preset: " .. tostring(err))
			self.ctx.toast("Could not load that preset", "error")
		end
	end)

	Kit.tooltip(click, spec.description or spec.name)

	self.cards[spec.id] = {
		frame = cardFrame,
		stroke = stroke,
	}
end

function Library:setQuery(query: string)
	self.search.Text = query
end

function Library:destroy()
	Kit.disconnectAll(self.connections or {})
	self.root:Destroy()
end

return Library
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX39">
				<Properties>
					<string name="Name">Preview</string>
					<bool name="Archivable">true</bool>
					<ProtectedString name="Source"><![CDATA[--[[
	Preview - the live 3D stage.

	A ViewportFrame with a WorldModel renders the real compiled instances:
	ParticleEmitters, Beams, Trails and PointLights all behave exactly as they
	will in-game. Orbit with the mouse, zoom with the wheel or the buttons,
	play/pause the timeline, and switch the lighting rig for context.
]]

local Util = require(script.Parent.Parent.Core.Util)
local Theme = require(script.Parent.Parent.Core.Theme)
local Compiler = require(script.Parent.Parent.Core.Compiler)
local Player = require(script.Parent.Parent.Core.Player)
local Performance = require(script.Parent.Parent.Core.Performance)
local Kit = require(script.Parent.Kit)

local UserInputService = game:GetService("UserInputService")

local Preview = {}
Preview.__index = Preview

local BACKGROUNDS = {
	{
		value = "studio",
		label = "Studio dark",
		ambient = Color3.fromRGB(66, 74, 92),
		light = Color3.fromRGB(150, 168, 200),
		direction = Vector3.new(-0.4, -1, -0.6),
		background = Color3.fromRGB(12, 15, 22),
		floor = Color3.fromRGB(26, 32, 45),
		floorTransparency = 0.15,
	},
	{
		value = "night",
		label = "Night",
		ambient = Color3.fromRGB(38, 44, 66),
		light = Color3.fromRGB(96, 116, 168),
		direction = Vector3.new(-0.3, -1, 0.4),
		background = Color3.fromRGB(6, 8, 14),
		floor = Color3.fromRGB(16, 20, 32),
		floorTransparency = 0.3,
	},
	{
		value = "day",
		label = "Daylight",
		ambient = Color3.fromRGB(150, 156, 168),
		light = Color3.fromRGB(255, 246, 230),
		direction = Vector3.new(-0.6, -1, -0.3),
		background = Color3.fromRGB(148, 164, 190),
		floor = Color3.fromRGB(120, 126, 136),
		floorTransparency = 0.05,
	},
	{
		value = "void",
		label = "Void",
		ambient = Color3.fromRGB(20, 22, 30),
		light = Color3.fromRGB(70, 80, 110),
		direction = Vector3.new(0, -1, 0),
		background = Color3.fromRGB(2, 3, 6),
		floor = Color3.fromRGB(8, 10, 16),
		floorTransparency = 0.6,
	},
}

local SPEEDS = {
	{ value = 0.25, label = "0.25x" },
	{ value = 0.5, label = "0.5x" },
	{ value = 1, label = "1.0x" },
	{ value = 1.5, label = "1.5x" },
	{ value = 2, label = "2.0x" },
}

local function radiusOf(spec: any): number
	local radius = 3
	for _, comp in ipairs(spec.components or {}) do
		local offset = comp.offset or comp.offset1 or { 0, 0, 0 }
		local reach = math.sqrt((tonumber(offset[1]) or 0) ^ 2 + (tonumber(offset[2]) or 0) ^ 2 + (tonumber(offset[3]) or 0) ^ 2)
		if comp.kind == "particle" then
			local largest = 0
			for _, kp in ipairs(comp.size or {}) do
				largest = math.max(largest, tonumber(kp[2]) or 0)
			end
			reach += largest * 0.5
		elseif comp.kind == "part" then
			local size = comp.size or { 1, 1, 1 }
			reach += math.sqrt((tonumber(size[1]) or 1) ^ 2 + (tonumber(size[2]) or 1) ^ 2 + (tonumber(size[3]) or 1) ^ 2) * 0.5
		elseif comp.kind == "beam" then
			reach += math.abs(tonumber(comp.width0) or 0) + math.abs(tonumber(comp.curveSize0) or 0)
		end
		radius = math.max(radius, reach)
	end
	return math.clamp(radius, 3, 80)
end

function Preview.new(parent: Instance, ctx: any)
	local self = setmetatable({}, Preview)
	self.ctx = ctx
	self.store = ctx.store
	self.azimuth = 32
	self.elevation = 16
	self.distance = 16
	self.target = Vector3.new(0, 0.4, 0)
	self.autoFrame = true
	self.speed = 1
	self.playStarted = 0
	self.lastProgress = 0
	self.hovering = false
	self.dragging = false
	self.connections = {}

	local root = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.color.bg0,
		ClipsDescendants = true,
	})
	self.root = root

	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.new(1, 0, 1, -44)
	viewport.Position = UDim2.fromOffset(0, 0)
	viewport.BackgroundColor3 = Theme.color.bg0
	viewport.BorderSizePixel = 0
	viewport.Ambient = BACKGROUNDS[1].ambient
	viewport.LightColor = BACKGROUNDS[1].light
	viewport.LightDirection = BACKGROUNDS[1].direction
	viewport.Parent = root
	self.viewport = viewport

	local world = Instance.new("WorldModel")
	world.Parent = viewport
	self.world = world

	local camera = Instance.new("Camera")
	camera.FieldOfView = 50
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	self.camera = camera

	local floor = Instance.new("Part")
	floor.Name = "PreviewFloor"
	floor.Anchored = true
	floor.CanCollide = false
	floor.CanQuery = false
	floor.CanTouch = false
	floor.CastShadow = false
	floor.Material = Enum.Material.SmoothPlastic
	floor.Color = BACKGROUNDS[1].floor
	floor.Transparency = BACKGROUNDS[1].floorTransparency
	floor.Size = Vector3.new(0.2, 44, 44)
	floor.CFrame = CFrame.new(0, -1.15, 0) * CFrame.Angles(0, 0, math.pi / 2)
	floor.Parent = world
	self.floor = floor

	local rim = Instance.new("PointLight")
	rim.Brightness = 1.4
	rim.Range = 40
	rim.Color = Color3.fromRGB(150, 180, 255)
	rim.Shadows = false
	rim.Parent = floor

	-- Overlay: preset identity ------------------------------------------------
	local identity = Kit.frame(root, {
		Size = UDim2.new(1, -24, 0, 42),
		Position = UDim2.fromOffset(12, 10),
		BackgroundColor3 = Theme.color.bg0,
		BackgroundTransparency = 0.35,
		ClipsDescendants = false,
	})
	Theme.corner(identity, Theme.radius.sm)
	self.identity = identity

	self.nameLabel = Kit.label(identity, "Loading...", {
		Size = UDim2.new(1, -110, 0, 18),
		Position = UDim2.fromOffset(10, 4),
		Font = Theme.font.bold,
		TextSize = Theme.text.subtitle,
	})
	self.metaLabel = Kit.label(identity, "", {
		Size = UDim2.new(1, -110, 0, 14),
		Position = UDim2.fromOffset(10, 22),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
	})
	self.costButton = Kit.button(identity, "", {
		variant = "secondary",
		height = 24,
		size = UDim2.fromOffset(86, 24),
		textSize = Theme.text.tiny,
		onClick = function()
			ctx.openPanel("Cost")
		end,
		tooltip = "Open the performance report",
	})
	self.costButton.Position = UDim2.new(1, -96, 0, 9)

	-- Overlay: orbit hint ------------------------------------------------------
	self.hint = Kit.caption(viewport, "Drag to orbit  \u{00b7}  Scroll to zoom", {
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.new(0, 0, 1, -20),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Theme.color.textFaint,
		TextSize = Theme.text.tiny,
	})

	-- Overlay: compile error ---------------------------------------------------
	self.errorFrame = Kit.frame(viewport, {
		Size = UDim2.new(1, -40, 0, 0),
		Position = UDim2.new(0, 20, 0.5, -30),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.color.badSoft,
		Visible = false,
		ClipsDescendants = false,
	})
	Theme.corner(self.errorFrame, Theme.radius.sm)
	self.errorLabel = Kit.label(self.errorFrame, "", {
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.fromOffset(10, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextColor3 = Theme.color.bad,
		TextSize = Theme.text.small,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	-- Control bar --------------------------------------------------------------
	local bar = Kit.frame(root, {
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.new(0, 0, 1, -44),
		BackgroundColor3 = Theme.color.bg1,
	})
	self.bar = bar
	Theme.stroke(bar, Theme.color.line, 1, 0.5)

	local controls = Kit.hlist(bar, 6, {
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
	})
	controls.AutomaticSize = Enum.AutomaticSize.None
	controls.Size = UDim2.new(1, -20, 1, 0)

	self.playButton = Kit.button(controls, "\u{25b6}", {
		variant = "primary",
		size = UDim2.fromOffset(34, 28),
		textSize = 13,
		tooltip = "Play / pause  (Space)",
		onClick = function()
			self:togglePlay()
		end,
	})
	self.restartButton = Kit.iconButton(controls, "\u{21bb}", {
		size = UDim2.fromOffset(28, 28),
		tooltip = "Restart timeline  (R)",
		onClick = function()
			self:restart()
		end,
	})

	local speedHolder = Kit.frame(controls, {
		Size = UDim2.fromOffset(74, 28),
		BackgroundTransparency = 1,
	})
	local speedDropdown = Kit.dropdown(speedHolder, {
		options = SPEEDS,
		value = 1,
		height = 28,
		maxHeight = 140,
		onChange = function(value)
			self:setSpeed(tonumber(value) or 1)
		end,
	})
	speedDropdown.Set(1)
	speedHolder.Size = UDim2.fromOffset(74, 28)
	speedDropdown.Set(1)

	local loopToggle = Kit.toggle(controls, self.store:getPref("loop", false), function(value)
		self.store:setPref("loop", value)
		if self.player then
			self.player.loop = value
		end
		if value and self.player and not self.player:IsPlaying() then
			self:play()
		end
	end)
	Kit.tooltip(loopToggle :: any, "Loop the effect")
	self.loopToggle = loopToggle

	Kit.label(controls, "Loop", {
		Size = UDim2.fromOffset(30, 28),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
	})

	-- Spacer pushes the view controls to the right.
	local spacer = Kit.frame(controls, {
		Size = UDim2.fromOffset(8, 28),
		BackgroundTransparency = 1,
	})
	spacer.LayoutOrder = 50

	local zoomOut = Kit.iconButton(controls, "\u{2212}", {
		size = UDim2.fromOffset(26, 26),
		tooltip = "Zoom out",
		onClick = function()
			self:zoom(1.18)
		end,
	})
	local zoomIn = Kit.iconButton(controls, "+", {
		size = UDim2.fromOffset(26, 26),
		tooltip = "Zoom in",
		onClick = function()
			self:zoom(1 / 1.18)
		end,
	})
	local frameButton = Kit.iconButton(controls, "\u{25a3}", {
		size = UDim2.fromOffset(26, 26),
		tooltip = "Frame the effect",
		onClick = function()
			self:frameCamera()
		end,
	})

	local bgHolder = Kit.frame(controls, {
		Size = UDim2.fromOffset(112, 28),
		BackgroundTransparency = 1,
	})
	local backgroundDropdown = Kit.dropdown(bgHolder, {
		options = (function()
			local list = {}
			for _, entry in ipairs(BACKGROUNDS) do
				table.insert(list, { value = entry.value, label = entry.label })
			end
			return list
		end)(),
		value = self.store:getPref("background", "studio"),
		height = 28,
		maxHeight = 130,
		onChange = function(value)
			self:setBackground(tostring(value))
			self.store:setPref("background", tostring(value), { silent = true })
		end,
	})
	self.backgroundDropdown = backgroundDropdown

	-- Interactions -------------------------------------------------------------
	viewport.MouseEnter:Connect(function()
		self.hovering = true
		self.hint.Visible = false
	end)
	viewport.MouseLeave:Connect(function()
		self.hovering = false
	end)

	local orbitConnection
	viewport.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
			self.dragging = true
			self.dragOrigin = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	table.insert(self.connections, UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement and self.dragging and self.dragOrigin then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - self.dragOrigin
			self.dragOrigin = Vector2.new(input.Position.X, input.Position.Y)
			self.azimuth -= delta.X * 0.45
			self.elevation = math.clamp(self.elevation + delta.Y * 0.35, -78, 82)
			self:updateCamera()
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and self.hovering then
			self:zoom(1 - input.Position.Z * 0.12)
		end
	end))

	table.insert(self.connections, UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
			self.dragging = false
		end
	end))

	-- Store bindings ------------------------------------------------------------
	table.insert(self.connections, self.store.signals:on("spec", function()
		self:rebuild(true)
	end))
	table.insert(self.connections, self.store.signals:on("field", function(payload)
		self:onField(payload)
	end))

	self:setBackground(self.store:getPref("background", "studio"))
	self:rebuild(true)
	return self
end

--------------------------------------------------------------------------------
-- model lifecycle
--------------------------------------------------------------------------------

function Preview:showError(message: string?)
	if message and message ~= "" then
		self.errorLabel.Text = "Preview error\n" .. message
		self.errorFrame.Visible = true
	else
		self.errorFrame.Visible = false
	end
end

function Preview:destroyModel()
	if self.player then
		pcall(function()
			self.player:Destroy()
		end)
		self.player = nil
	end
	if self.model then
		pcall(function()
			self.model:Destroy()
		end)
		self.model = nil
	end
end

function Preview:rebuild(restartPlayback: boolean?)
	local spec = self.store:working()
	local wasPlaying = self.player ~= nil and self.player:IsPlaying()

	if not self.model then
		local ok, result = pcall(Compiler.build, spec, self.world)
		if not ok then
			self:showError(tostring(result))
			self.ctx.toast("Could not build the preview", "error")
			return
		end
		self.model = result
	else
		local ok, err = pcall(Compiler.reconcile, self.model, spec)
		if not ok then
			-- A structural change it cannot reconcile: rebuild from scratch.
			self:destroyModel()
			local retryOk, result = pcall(Compiler.build, spec, self.world)
			if not retryOk then
				self:showError(tostring(result))
				return
			end
			self.model = result
			err = nil
		end
		if err then
			self:showError(tostring(err))
			return
		end
	end

	self:showError(nil)
	self.model.Name = tostring(spec.name or "Effect")

	local playerOk, playerOrError = pcall(Player.new, self.model, spec)
	if not playerOk then
		self:showError(tostring(playerOrError))
		return
	end
	if self.player then
		pcall(function()
			self.player:Destroy()
		end)
	end
	self.player = playerOrError
	self.player.loop = self.store:getPref("loop", false)
	self.player:SetSpeed(self.speed)

	self:updateIdentity()
	self:updateCost()

	local shouldPlay = wasPlaying or (restartPlayback and self.store:getPref("autoPlay", true))
	if shouldPlay then
		self:play()
	else
		self.player:Reset()
		self.lastProgress = 0
		self.playButton.Text = "\u{25b6}"
	end
end

function Preview:onField(payload: any)
	if not self.model then
		self:rebuild(false)
		return
	end
	local ok, err = pcall(Compiler.reconcile, self.model, self.store:working())
	if not ok then
		self:rebuild(false)
		return
	end
	if err then
		self:showError(tostring(err))
	else
		self:showError(nil)
	end
	if self.player then
		if payload and (payload.key == "startTime" or payload.key == "duration") then
			if self.player:IsPlaying() then
				self:play()
			end
		end
	end
	self:updateCost()
end

function Preview:updateIdentity()
	local spec = self.store:working()
	self.nameLabel.Text = tostring(spec.name or "Untitled")
	local tags = table.concat(spec.tags or {}, "  \u{00b7}  ")
	self.metaLabel.Text = string.format(
		"%s  \u{00b7}  %s  \u{00b7}  %d components",
		tostring(spec.category or "Custom"),
		Util.formatDuration(spec.duration or 1),
		#(spec.components or {})
	)
	if tags ~= "" then
		self.metaLabel.Text ..= "  \u{00b7}  " .. tags
	end
end

function Preview:updateCost()
	local report = Performance.analyze(self.store:working())
	local color = Theme.color.good
	if report.grade == "B" then
		color = Theme.color.accentBright
	elseif report.grade == "C" then
		color = Theme.color.warn
	elseif report.grade == "D" then
		color = Theme.color.bad
	end
	self.costButton.Text = string.format("%s  %d%%", report.grade, math.floor(report.score))
	self.costButton.TextColor3 = color
end

--------------------------------------------------------------------------------
-- playback
--------------------------------------------------------------------------------

function Preview:play()
	if not self.player then
		return
	end
	self.player.loop = self.store:getPref("loop", false)
	self.player:SetSpeed(self.speed)
	self.player:Reset()
	self.player:Play()
	self.playStarted = os.clock()
	self.lastProgress = 0
	self.playButton.Text = "\u{2016}\u{2016}"
end

function Preview:pause()
	if not self.player then
		return
	end
	self.lastProgress = self:progress()
	self.player:Stop()
	self.playButton.Text = "\u{25b6}"
end

function Preview:togglePlay()
	if not self.player then
		return
	end
	if self.player:IsPlaying() then
		self:pause()
	else
		self:play()
	end
end

function Preview:restart()
	self:play()
end

function Preview:setSpeed(speed: number)
	self.speed = math.clamp(speed or 1, 0.1, 4)
	if self.player then
		self.player:SetSpeed(self.speed)
	end
end

function Preview:progress(): number
	if not self.player or not self.player:IsPlaying() then
		return self.lastProgress or 0
	end
	local duration = math.max(0.1, tonumber(self.store:working().duration) or 1)
	local elapsed = (os.clock() - self.playStarted) * self.speed
	local fraction = elapsed / duration
	if self.player.loop then
		fraction = fraction % 1
	elseif fraction > 1 then
		fraction = 1
		self.lastProgress = 1
		self.playButton.Text = "\u{25b6}"
	end
	return math.clamp(fraction, 0, 1)
end

function Preview:isPlaying(): boolean
	return self.player ~= nil and self.player:IsPlaying()
end

--- Keeps the play glyph honest when a one-shot effect ends on its own.
function Preview:syncPlayState()
	if not self.player then
		return
	end
	local playing = self.player:IsPlaying()
	local glyph = if playing then "\u{2016}\u{2016}" else "\u{25b6}"
	if self.playButton.Text ~= glyph then
		self.playButton.Text = glyph
	end
end

--------------------------------------------------------------------------------
-- camera / environment
--------------------------------------------------------------------------------

function Preview:updateCamera()
	local azimuth = math.rad(self.azimuth)
	local elevation = math.rad(self.elevation)
	local direction = Vector3.new(
		math.cos(elevation) * math.sin(azimuth),
		math.sin(elevation),
		math.cos(elevation) * math.cos(azimuth)
	)
	self.camera.CFrame = CFrame.lookAt(self.target + direction * self.distance, self.target)
end

function Preview:frameCamera()
	local spec = self.store:working()
	local radius = radiusOf(spec)
	self.distance = math.clamp(radius * 2.7, 6, 220)
	self.target = Vector3.new(0, math.min(radius * 0.35, 8), 0)
	self:updateCamera()
end

function Preview:zoom(multiplier: number)
	self.distance = math.clamp(self.distance * multiplier, 3, 300)
	self:updateCamera()
end

function Preview:setBackground(name: string)
	local entry = BACKGROUNDS[1]
	for _, candidate in ipairs(BACKGROUNDS) do
		if candidate.value == name then
			entry = candidate
			break
		end
	end
	self.viewport.BackgroundColor3 = entry.background
	self.viewport.Ambient = entry.ambient
	self.viewport.LightColor = entry.light
	self.viewport.LightDirection = entry.direction
	self.floor.Color = entry.floor
	self.floor.Transparency = entry.floorTransparency
end

function Preview:destroy()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self:destroyModel()
	self.root:Destroy()
end

return Preview
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX40">
				<Properties>
					<string name="Name">Timeline</string>
					<bool name="Archivable">true</bool>
					<ProtectedString name="Source"><![CDATA[--[[
	Timeline - the emission timeline.

	One row per component with a draggable bar: drag the body to slide it in
	time, drag either edge to change its window. The playhead follows the live
	preview, and clicking a row selects that component everywhere in the UI.
]]

local Util = require(script.Parent.Parent.Core.Util)
local Theme = require(script.Parent.Parent.Core.Theme)
local Kit = require(script.Parent.Kit)

local Timeline = {}
Timeline.__index = Timeline

local ROW_HEIGHT = 24
local NAME_WIDTH = 118

local KIND_COLORS = {
	particle = Theme.color.accent,
	beam = Color3.fromRGB(96, 208, 255),
	trail = Color3.fromRGB(96, 226, 168),
	light = Theme.color.warn,
	part = Color3.fromRGB(184, 150, 255),
	tween = Theme.color.textMuted,
}

local KIND_GLYPHS = {
	particle = "\u{273b}",
	beam = "\u{2726}",
	trail = "\u{2192}",
	light = "\u{2600}",
	part = "\u{25c6}",
	tween = "\u{21bb}",
}

function Timeline.new(parent: Instance, ctx: any)
	local self = setmetatable({}, Timeline)
	self.ctx = ctx
	self.store = ctx.store
	self.preview = ctx.preview
	self.rows = {}
	self.span = 2
	self.progress = 0
	self.connections = {}

	local root = Kit.frame(parent, {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.color.bg1,
		ClipsDescendants = true,
	})
	self.root = root

	local header = Kit.frame(root, {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		ClipsDescendants = false,
	})
	local title = Kit.label(header, "Timeline", {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.fromOffset(70, 18),
		Font = Theme.font.bold,
		TextSize = Theme.text.small,
	})

	local durationLabel = Kit.caption(header, "Duration", {
		Position = UDim2.fromOffset(86, 6),
		Size = UDim2.fromOffset(56, 18),
		TextSize = Theme.text.tiny,
	})

	local durationHolder = Kit.frame(header, {
		Size = UDim2.fromOffset(58, 22),
		Position = UDim2.fromOffset(142, 4),
		BackgroundTransparency = 1,
	})
	local durationWrapper, durationField = Kit.numberBox(durationHolder, self.store:working().duration, {
		min = 0.2,
		max = 30,
		size = UDim2.new(1, 0, 0, 22),
		onChange = function(value)
			self.store:setSpecField("duration", value, true)
		end,
	})
	self.durationField = durationField
	durationWrapper.Parent = durationHolder

	Kit.label(header, "s", {
		Position = UDim2.fromOffset(204, 6),
		Size = UDim2.fromOffset(10, 18),
		TextColor3 = Theme.color.textMuted,
		TextSize = Theme.text.tiny,
	})

	local fitButton = Kit.button(header, "Fit", {
		variant = "ghost",
		height = 20,
		size = UDim2.fromOffset(38, 20),
		textSize = Theme.text.tiny,
		tooltip = "Set the duration to the last component end",
		onClick = function()
			local longest = 0.5
			for _, comp in ipairs(self.store:working().components) do
				longest = math.max(longest, (tonumber(comp.startTime) or 0) + (tonumber(comp.duration) or 0))
			end
			self.store:setSpecField("duration", math.max(0.5, Util.round(longest, 2)), true)
			self.durationField.Set(math.max(0.5, Util.round(longest, 2)))
			self:refresh()
		end,
	})
	fitButton.Position = UDim2.fromOffset(218, 4)

	self.progressLabel = Kit.label(header, "0.00s", {
		Size = UDim2.fromOffset(60, 18),
		Position = UDim2.new(1, -74, 0, 6),
		TextColor3 = Theme.color.textMuted,
		Font = Theme.font.mono,
		TextSize = Theme.text.tiny,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	self.playheadLabel = self.progressLabel

	local divider = Kit.divider(root)
	divider.Position = UDim2.fromOffset(0, 30)

	-- Ruler -------------------------------------------------------------------
	local ruler = Kit.frame(root, {
		Size = UDim2.new(1, -NAME_WIDTH - 16, 0, 16),
		Position = UDim2.fromOffset(NAME_WIDTH + 8, 32),
		BackgroundTransparency = 1,
	})
	self.ruler = ruler

	-- Rows --------------------------------------------------------------------
	local scroll, content = Kit.scroll(root, {
		Size = UDim2.new(1, 0, 1, -84),
		Position = UDim2.fromOffset(0, 50),
	}, 2)
	scroll.ScrollBarThickness = 3
	self.scroll = scroll
	self.rowHolder = content

	local rowsFrame = Kit.frame(content, {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	local rowsLayout = Instance.new("UIListLayout")
	rowsLayout.Padding = UDim.new(0, 1)
	rowsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowsLayout.Parent = rowsFrame
	self.rowsFrame = rowsFrame

	-- Playhead spans the row area.
	local playhead = Kit.frame(root, {
		Size = UDim2.fromOffset(1, 0),
		Position = UDim2.fromOffset(NAME_WIDTH + 8, 50),
		BackgroundColor3 = Theme.color.accentBright,
		BackgroundTransparency = 0.15,
		ZIndex = 5,
	})
	playhead.Size = UDim2.new(0, 1, 1, -86)
	self.playhead = playhead

	local headDot = Kit.frame(playhead, {
		Size = UDim2.fromOffset(7, 7),
		Position = UDim2.new(0.5, -3, 0, -3),
		BackgroundColor3 = Theme.color.accentBright,
		ZIndex = 6,
	})
	Theme.corner(headDot, Theme.radius.pill)

	-- Empty state / add --------------------------------------------------------
	local footer = Kit.hlist(root, 6, {
		Size = UDim2.new(1, -20, 0, 26),
		Position = UDim2.new(0, 10, 1, -32),
	})
	footer.AutomaticSize = Enum.AutomaticSize.None
	footer.Size = UDim2.new(1, -20, 0, 26)

	self.addButton = Kit.button(footer, "+ Add component", {
		variant = "accentSoft",
		height = 24,
		size = UDim2.new(0, 132, 0, 24),
		textSize = Theme.text.small,
		onClick = function()
			self.store:addComponent("particle")
		end,
	})
	Kit.caption(footer, "Drag bars to retime  \u{00b7}  drag an edge to resize", {
		Size = UDim2.new(1, -140, 0, 24),
		TextSize = Theme.text.tiny,
	})

	self.rulerTicks = {}
	self:refresh()
	self:bind()
	return self
end

function Timeline:bind()
	table.insert(self.connections, self.store.signals:on("spec", function()
		self:refresh()
		if self.durationField then
			self.durationField.Set(self.store:working().duration)
		end
	end))
	table.insert(self.connections, self.store.signals:on("selection", function(index)
		self:highlight(index)
	end))
	table.insert(self.connections, self.store.signals:on("field", function(payload)
		-- Never rebuild the rows while the developer is dragging one of them.
		if self.dragging then
			return
		end
		if payload and (payload.key == "startTime" or payload.key == "duration") then
			self:refresh()
		end
	end))
end

function Timeline:computeSpan(): number
	local spec = self.store:working()
	local span = math.max(0.5, tonumber(spec.duration) or 1)
	for _, comp in ipairs(spec.components or {}) do
		span = math.max(span, (tonumber(comp.startTime) or 0) + (tonumber(comp.duration) or 0))
	end
	-- A little headroom so the last bar is not glued to the edge.
	return span * 1.04
end

function Timeline:refresh()
	Kit.clear(self.rowsFrame)
	self.rows = {}
	self.span = self:computeSpan()
	self:renderRuler()

	local spec = self.store:working()
	local index = 0
	for _, comp in ipairs(spec.components or {}) do
		index += 1
		self:createRow(comp, index)
	end

	self:highlight(self.store.selection)

	if #spec.components == 0 then
		local empty = Kit.label(self.rowsFrame, "No components. Add one below, or load a preset.", {
			Size = UDim2.new(1, -20, 0, 24),
			Position = UDim2.fromOffset(12, 4),
			TextColor3 = Theme.color.textMuted,
			TextSize = Theme.text.small,
		})
		empty.LayoutOrder = -1
	end
end

function Timeline:renderRuler()
	for _, tick in ipairs(self.rulerTicks) do
		tick:Destroy()
	end
	self.rulerTicks = {}

	local span = self.span
	local steps = 6
	for index = 0, steps do
		local fraction = index / steps
		local x = math.floor(fraction * 1000) / 10
		local label = Kit.label(self.ruler, string.format("%.2fs", span * fraction), {
			Size = UDim2.fromOffset(42, 14),
			Position = UDim2.new(fraction, -21, 0, 0),
			TextColor3 = Theme.color.textFaint,
			TextSize = Theme.text.tiny,
			Font = Theme.font.mono,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
		table.insert(self.rulerTicks, label)
	end
end

function Timeline:createRow(comp: any, index: number)
	local row = Kit.frame(self.rowsFrame, {
		Size = UDim2.new(1, 0, 0, ROW_HEIGHT),
		BackgroundColor3 = if index % 2 == 0 then Theme.color.bg2 else Theme.color.bg1,
		BackgroundTransparency = if index % 2 == 0 then 0.35 else 1,
		ClipsDescendants = false,
	})
	row.LayoutOrder = index

	local color = KIND_COLORS[comp.kind] or Theme.color.textDim

	local dot = Kit.frame(row, {
		Size = UDim2.fromOffset(5, 5),
		Position = UDim2.fromOffset(10, 10),
		BackgroundColor3 = color,
	})
	Theme.corner(dot, Theme.radius.pill)

	local name = Kit.label(row, string.format("%s %s", KIND_GLYPHS[comp.kind] or "\u{25c6}", tostring(comp.name)), {
		Size = UDim2.fromOffset(NAME_WIDTH - 16, ROW_HEIGHT),
		Position = UDim2.fromOffset(20, 0),
		TextColor3 = Theme.color.textDim,
		TextSize = Theme.text.tiny,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Kit.tooltip(name, tostring(comp.name))

	local track = Kit.frame(row, {
		Size = UDim2.new(1, -NAME_WIDTH - 16, 0, ROW_HEIGHT),
		Position = UDim2.fromOffset(NAME_WIDTH, 0),
		BackgroundTransparency = 1,
	})

	local lane = Kit.frame(track, {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.new(0, 0, 0.5, -4),
		BackgroundColor3 = Theme.color.bg3,
	})
	lane.ZIndex = 1
	Theme.corner(lane, Theme.radius.pill)

	local startTime = tonumber(comp.startTime) or 0
	local duration = tonumber(comp.duration) or 0
	local bar = Kit.frame(track, {
		Size = UDim2.fromScale(math.max(0.006, duration / self.span), 1),
		Position = UDim2.fromScale(startTime / self.span, 0),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.25,
		ZIndex = 2,
	})
	Theme.corner(bar, Theme.radius.sm)
	bar.Size = UDim2.new(math.max(0.006, duration / self.span), 0, 0, 16)
	bar.Position = UDim2.new(startTime / self.span, 0, 0.5, -8)

	local barLabel = Kit.label(bar, if duration > 0.08 then string.format("%.2fs", duration) else "", {
		Size = UDim2.new(1, -8, 1, 0),
		Position = UDim2.fromOffset(4, 0),
		TextColor3 = Theme.color.white,
		TextSize = Theme.text.tiny,
		Font = Theme.font.mono,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local leftHandle = Kit.frame(bar, {
		Size = UDim2.new(0, 4, 1, 0),
		BackgroundColor3 = Theme.color.white,
		BackgroundTransparency = 0.6,
		ZIndex = 3,
	})
	local rightHandle = Kit.frame(bar, {
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.new(1, -4, 0, 0),
		BackgroundColor3 = Theme.color.white,
		BackgroundTransparency = 0.6,
		ZIndex = 3,
	})

	local function trackWidth(): number
		return math.max(24, track.AbsoluteSize.X)
	end

	local dragState: any = nil

	local function beginDrag(mode: string, startX: number)
		self.store:pushHistory("Adjust timing")
		self.dragging = true
		dragState = {
			mode = mode,
			startX = startX,
			startTime = tonumber(comp.startTime) or 0,
			startDuration = tonumber(comp.duration) or 0,
		}
		self.store:select(index)
	end

	local function moveDrag(mouseX: number)
		if not dragState then
			return
		end
		local delta = (mouseX - dragState.startX) / trackWidth() * self.span
		if dragState.mode == "move" then
			local newStart = math.max(0, Util.round(dragState.startTime + delta, 2))
			comp.startTime = newStart
			self.store:setField(index, "startTime", newStart)
		elseif dragState.mode == "left" then
			local newStart = math.clamp(Util.round(dragState.startTime + delta, 2), 0, dragState.startTime + dragState.startDuration - 0.05)
			local newDuration = math.max(0.05, Util.round(dragState.startDuration - (newStart - dragState.startTime), 2))
			comp.startTime = newStart
			comp.duration = newDuration
			self.store:setField(index, "startTime", newStart)
			self.store:setField(index, "duration", newDuration)
		elseif dragState.mode == "right" then
			local newDuration = math.max(0.05, Util.round(dragState.startDuration + delta, 2))
			comp.duration = newDuration
			self.store:setField(index, "duration", newDuration)
		end
		self:updateBar(index, bar, barLabel)
	end

	local function finishDrag()
		dragState = nil
		self.dragging = false
		self:refresh()
	end

	Kit.drag(bar, {
		begin = function(x)
			beginDrag("move", x)
		end,
		move = function(x)
			moveDrag(x)
		end,
		finish = finishDrag,
	})
	Kit.drag(leftHandle, {
		begin = function(x)
			beginDrag("left", x)
		end,
		move = function(x)
			moveDrag(x)
		end,
		finish = finishDrag,
	})
	Kit.drag(rightHandle, {
		begin = function(x)
			beginDrag("right", x)
		end,
		move = function(x)
			moveDrag(x)
		end,
		finish = finishDrag,
	})

	local selectClick = Instance.new("TextButton")
	selectClick.BackgroundTransparency = 1
	selectClick.Text = ""
	selectClick.Size = UDim2.new(1, -NAME_WIDTH, 1, 0)
	selectClick.Position = UDim2.fromOffset(NAME_WIDTH, 0)
	selectClick.ZIndex = 1
	selectClick.Parent = row
	selectClick.Activated:Connect(function()
		self.store:select(index)
	end)

	self.rows[index] = {
		frame = row,
		bar = bar,
		label = barLabel,
		comp = comp,
	}
end

function Timeline:updateBar(index: number, bar: Frame, label: TextLabel)
	local comp = self.rows[index] and self.rows[index].comp
	if not comp then
		return
	end
	local startTime = tonumber(comp.startTime) or 0
	local duration = tonumber(comp.duration) or 0
	bar.Position = UDim2.new(startTime / self.span, 0, 0.5, -8)
	bar.Size = UDim2.new(math.max(0.006, duration / self.span), 0, 0, 16)
	label.Text = if duration > 0.08 then string.format("%.2fs", duration) else ""
end

function Timeline:highlight(index: number)
	for rowIndex, row in pairs(self.rows) do
		if rowIndex == index then
			row.frame.BackgroundColor3 = Theme.color.bg3
			row.frame.BackgroundTransparency = 0
		else
			row.frame.BackgroundColor3 = if rowIndex % 2 == 0 then Theme.color.bg2 else Theme.color.bg1
			row.frame.BackgroundTransparency = if rowIndex % 2 == 0 then 0.35 else 1
		end
	end
end

function Timeline:setProgress(fraction: number, seconds: number)
	self.progress = math.clamp(fraction, 0, 1)
	local rulerWidth = self.ruler.AbsoluteSize.X
	self.playhead.Position = UDim2.new(
		0,
		NAME_WIDTH + 8 + math.floor(self.progress * rulerWidth),
		0,
		50
	)
	if self.playheadLabel then
		self.playheadLabel.Text = string.format("%.2fs", seconds or 0)
	end
end

function Timeline:destroy()
	for _, connection in ipairs(self.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	self.root:Destroy()
end

return Timeline
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
</roblox>
