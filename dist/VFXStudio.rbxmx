	-- 01
	preset("Smoke Plume", { "plume", "column", "loop" }, 4, {
		P { tex = "smoke", col = { "#d8d8d8", "#9a9a9a", "#4a4a4a" }, trn = { 0.55, 0.85, 0.98 }, sz = { 3, 12 }, life = { 2.2, 3.6 }, spd = { 1.5, 4 }, sprd = { 10, 10 }, rate = 26, accel = { 0, 4, 0 }, shape = "Disc", dur = 4 },
