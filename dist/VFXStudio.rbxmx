		P { tex = "smoke", col = { "#c5b193", "#5c4c34" }, trn = { 0.7, 0.95 }, sz = { 6, 18 }, life = { 1.8, 2.8 }, spd = { 1, 4 }, sprd = { 180, 180 }, rate = 14, at = 0.4, dur = 2.2 },
