		P { name = "Rim", tex = "electric", col = { "#eaffff", "#6ae8ff" }, trn = { 0.2, 0.85, 1 }, sz = { 0.2, 0.8 }, life = { 0.3, 0.8 }, spd = { 1, 6 }, sprd = { 60, 60 }, rate = 34, light = 1.4, dur = 2.6 },
